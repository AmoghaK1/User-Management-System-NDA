<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Half-Yearly Fee Payment | NDA</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="../images/favicon-2.0.3/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../images/favicon-2.0.3/favicon.svg" />
    <link rel="shortcut icon" href="../images/favicon-2.0.3/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon-2.0.3/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Nrutyashree" />
    <link rel="manifest" href="../images/favicon-2.0.3/site.webmanifest" />
    <style>
        .halfyearly-card {
            transition: all 0.3s ease;
        }
        .halfyearly-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
        }
        .paid-status {
            background-color: #ecfdf5;
            border-color: #d1fae5;
        }
        .pending-status {
            background-color: #fff7ed;
            border-color: #ffedd5;
        }
        .upcoming-status {
            background-color: #f3f4f6;
            border-color: #e5e7eb;
        }
        .loading-spinner {
            border: 4px solid rgba(0, 0, 0, 0.1);
            border-radius: 50%;
            border-top: 4px solid #6B46C1;
            width: 40px;
            height: 40px;
            animation: spin 1s linear infinite;
            margin: 20px auto;
        }
        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }
    </style>
</head>
<body class="min-h-screen bg-gray-50 p-6">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="flex items-center mb-6">
            <img class="w-12 h-12 rounded-full bg-gray-200" src=<%= user.profilePicture %> alt="Profile">
            <div class="ml-3">
                <span class="text-2xl font-bold text-gray-800"><%= user.name %></span>
                <div class="text-lg text-gray-500"><%= user.exam_level %></div>
            </div>
        </div>

        <!-- Half-Yearly Payment Section -->
        <div id="halfYearlySection">
            <div class="bg-white rounded-xl shadow-sm p-6 mb-6">
                <div class="flex items-center justify-between mb-6">
                    <h2 class="text-3xl font-bold text-gray-800">Half-Yearly Fee Status</h2>
                    <div class="flex items-center space-x-4">
                        <button id="prevYearHalfYearly" class="p-2 hover:bg-gray-100 rounded-full transition-colors">
                            <svg class="w-6 h-6 text-gray-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="15 18 9 12 15 6"></polyline>
                            </svg>
                        </button>
                        <span id="currentYearHalfYearly" class="text-xl font-semibold text-gray-800">2025</span>
                        <button id="nextYearHalfYearly" class="p-2 hover:bg-gray-100 rounded-full transition-colors">
                            <svg class="w-6 h-6 text-gray-800" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </button>
                    </div>
                </div>
                <div class="flex gap-6 mb-5 text-sm text-gray-600">
                    <div class="flex items-center">
                        <div class="w-3 h-3 rounded-full bg-green-400 mr-1"></div>
                        <span>Paid</span>
                    </div>
                    <div class="flex items-center">
                        <div class="w-3 h-3 rounded-full bg-yellow-400 mr-1"></div>
                        <span>Pending</span>
                    </div>
                    <div class="flex items-center">
                        <div class="w-3 h-3 rounded-full bg-red-400 mr-1"></div>
                        <span>Missed</span>
                    </div>
                </div>
                <!-- Half-Yearly Grid -->
                <div id="halfYearlyGrid" class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <!-- Half-yearly periods will be dynamically inserted here -->
                </div>
            </div>

            <!-- Back to Home Button -->
            <div class="text-center mt-6">
                <button 
                    id="backToHomeBtn" 
                    class="bg-purple-600 text-white px-6 py-3 rounded-lg cursor-pointer hover:bg-purple-700 transition-colors text-lg font-medium"
                    onclick="window.location.href = '/st-dashboard'">
                    Back to Home
                </button>
            </div>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>
    <script src="../javascripts/paymentLanding.js"></script>
    <script src="../javascripts/halfYearlyPayment.js"></script>
    
    <script>
        // Initialize half-yearly payment data
        document.addEventListener('DOMContentLoaded', async function() {
            window.userId = "<%= user._id %>";
            window.halfYearlyFee = "<%= user.exam_fee * 6 %>";
            window.monthlyFee = "<%= user.exam_fee %>";
            window.phoneNumber = "<%= user.student_ph_no %>";
            window.email = "<%= user.email %>";
            
            // Fetch payment status first
            await fetchPaymentStatus();
            
            // Initialize half-yearly UI
            if (typeof updateHalfYearlyGrid === 'function') {
                await updateHalfYearlyGrid();
            }
        });
    </script>
    
    <!-- Auto-refresh fee collection on payment updates -->
    <script src="../javascripts/paymentRefreshTrigger.js"></script>
</body>
</html>
