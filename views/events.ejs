<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="favicon" href="../images/nda-favicon-v2.png">
    <title>Events | NDA</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            padding: 0;
            background: linear-gradient(135deg, #f8f5ff 0%, #eee6ff 100%);
            min-height: 100vh;
        }
        
        .container {
            max-width: 1200px;
            margin: 30px auto;
            padding: 20px;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: calc(100vh - 60px);
        }
        
        .no-events-card {
            background-color: white;
            border-radius: 10px;
            box-shadow: 0 4px 15px rgba(142, 68, 173, 0.1);
            padding: 40px;
            text-align: center;
            width: 100%;
            max-width: 600px;
            animation: fadeInUp 0.8s ease forwards;
        }
        
        .calendar-icon {
            width: 80px;
            height: 80px;
            margin: 0 auto 20px;
            position: relative;
            animation: float 3s ease-in-out infinite;
        }
        
        .no-events-title {
            font-size: 26px;
            color: #333;
            margin-bottom: 15px;
            animation: fadeIn 1s ease 0.3s forwards;
            opacity: 0;
        }
        
        .no-events-message {
            color: #666;
            font-size: 16px;
            margin-bottom: 30px;
            line-height: 1.5;
            animation: fadeIn 1s ease 0.6s forwards;
            opacity: 0;
        }
        
        .back-btn {
            background-color: #8e44ad;
            color: white;
            border: none;
            padding: 12px 30px;
            border-radius: 5px;
            cursor: pointer;
            font-weight: bold;
            transition: all 0.3s;
            animation: fadeIn 1s ease 0.9s forwards;
            opacity: 0;
            box-shadow: 0 4px 8px rgba(142, 68, 173, 0.2);
        }
        
        .back-btn:hover {
            background-color: #7d3c98;
            transform: translateY(-2px);
            box-shadow: 0 6px 12px rgba(142, 68, 173, 0.3);
        }
        
        .back-btn:active {
            transform: translateY(0);
        }
        
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }
        
        @keyframes fadeIn {
            from {
                opacity: 0;
            }
            to {
                opacity: 1;
            }
        }
        
        @keyframes float {
            0% {
                transform: translateY(0px);
            }
            50% {
                transform: translateY(-10px);
            }
            100% {
                transform: translateY(0px);
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <div class="no-events-card">
            <div class="calendar-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80">
                    <rect x="5" y="15" width="70" height="60" rx="5" fill="#e0d1f0" stroke="#8e44ad" stroke-width="2"/>
                    <rect x="5" y="15" width="70" height="12" fill="#8e44ad"/>
                    <line x1="20" y1="5" x2="20" y2="25" stroke="#8e44ad" stroke-width="2"/>
                    <line x1="60" y1="5" x2="60" y2="25" stroke="#8e44ad" stroke-width="2"/>
                    
                    <!-- Calendar grid -->
                    <line x1="20" y1="40" x2="60" y2="40" stroke="#d5c5ea" stroke-width="1"/>
                    <line x1="20" y1="50" x2="60" y2="50" stroke="#d5c5ea" stroke-width="1"/>
                    <line x1="20" y1="60" x2="60" y2="60" stroke="#d5c5ea" stroke-width="1"/>
                    <line x1="30" y1="30" x2="30" y2="70" stroke="#d5c5ea" stroke-width="1"/>
                    <line x1="40" y1="30" x2="40" y2="70" stroke="#d5c5ea" stroke-width="1"/>
                    <line x1="50" y1="30" x2="50" y2="70" stroke="#d5c5ea" stroke-width="1"/>
                    
                    <!-- Highlight a cell -->
                    <rect x="50" y="50" width="10" height="10" fill="#8e44ad" opacity="0.5"/>
                </svg>
            </div>
            <h2 class="no-events-title">No Events Currently</h2>
            <p class="no-events-message">There are no upcoming events scheduled at this time. Check back later for updates.</p>
            <button class="back-btn" onclick="history.back()">Back to Dashboard</button>
        </div>
    </div>
</body>
</html>