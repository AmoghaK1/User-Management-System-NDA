<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teacher Dashboard</title>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">

  <style>
    :root {
      --primary-color: #6a5acd;
      --secondary-color: #f0f5ff;
      --accent-color: #ff5757;
      --text-color: #333;
      --light-text: #666;
      --border-radius: 12px;
      --box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
    }

    body {
      font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
      background-color: #f5f7fb;
      color: var(--text-color);
      margin: 0;
      padding: 0;
    }

    .my-navbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      background-color: var(--primary-color);
      color: white;
      padding: 0.75rem 2rem;
      box-shadow: var(--box-shadow);
    }

    .user-profile {
      display: flex;
      align-items: center;
      gap: 1rem;
    }

    #user-pfp {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      object-fit: cover;
      border: 2px solid white;
    }

    .navbar-center-section {
      font-size: 1.2rem;
      font-weight: 600;
    }

    .navbar-icons {
      display: flex;
      align-items: center;
      gap: 1.5rem;
    }

    .nav-icon {
      font-size: 1.2rem;
      cursor: pointer;
    }

    #logout-btn {
      background-color: var(--accent-color);
      color: white;
      border: none;
      padding: 0.5rem 1.25rem;
      border-radius: 50px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    #logout-btn:hover {
      background-color: #ff3333;
    }

    .thought-section {
      display: flex;
      justify-content: center;
      align-items: center;
      padding: 2rem 0;
    }

    .thought-box {
      background-color: white;
      padding: 1.5rem 2rem;
      border-radius: var(--border-radius);
      box-shadow: var(--box-shadow);
      max-width: 600px;
      position: relative;
      text-align: center;
    }

    .thought-box p {
      font-style: italic;
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
    }

    .author {
      display: block;
      text-align: right;
      color: var(--light-text);
    }

    .quote-mark {
      font-size: 2rem;
      color: #e0e0e0;
      position: absolute;
    }

    .quote-mark.left {
      top: 5px;
      left: 10px;
    }

    .quote-mark.right {
      bottom: 5px;
      right: 10px;
    }

    .main-section {
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      gap: 1.5rem;
      padding: 1rem 2rem 3rem;
    }

    .card {
      background-color: white;
      border-radius: var(--border-radius);
      box-shadow: var(--box-shadow);
      overflow: hidden;
      transition: all 0.3s ease;
      width: 100%;
      max-width: 290px;
    }

    .card:hover {
      transform: translateY(-5px);
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
    }

    .dashboard-section {
      background-color: white;
      border-radius: var(--border-radius);
      box-shadow: var(--box-shadow);
      padding: 1.25rem;
      margin-bottom: 1.5rem;
      transition: all 0.3s ease;
    }

    .dashboard-section:hover {
      box-shadow: 0 8px 15px rgba(0, 0, 0, 0.1);
    }

    .dashboard-section h3 {
      font-size: 1.1rem;
      font-weight: 600;
      margin-bottom: 1rem;
    }

    .updates-section {
      background-color: white;
      flex-basis: 30%;
    }

    .update-item {
      border-bottom: 1px solid #eee;
      padding: 0.75rem 0;
    }

    .update-item:last-child {
      border-bottom: none;
    }

    .update-title {
      font-weight: 600;
      font-size: 0.95rem;
    }

    .update-desc {
      font-size: 0.85rem;
      color: var(--light-text);
    }

    .update-time {
      font-size: 0.75rem;
      color: #999;
      margin-top: 0.25rem;
    }

    .stats-card {
      background-color: #f5f9ff;
      border-radius: var(--border-radius);
      padding: 1.25rem;
      margin-bottom: 1rem;
    }

    .stats-card.purple {
      background-color: #f5f0ff;
    }

    .stats-card.blue {
      background-color: #f0f5ff;
    }

    .stats-card.green {
      background-color: #f0fff5;
    }

    .stats-card.yellow {
      background-color: #fffbf0;
    }

    .stats-header {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 1rem;
    }

    .stats-title {
      font-weight: 600;
    }

    .stats-icon {
      font-size: 1.5rem;
      color: var(--primary-color);
    }

    .stats-info {
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .stats-number {
      font-size: 1.25rem;
      font-weight: 700;
    }

    .progress-bar {
      height: 8px;
      background-color: #e0e0e0;
      border-radius: 4px;
      margin-top: 0.75rem;
      overflow: hidden;
    }

    .progress-fill {
      height: 100%;
      border-radius: 4px;
    }

    .purple-fill {
      background-color: #6a5acd;
      width: 93%;
    }

    .blue-fill {
      background-color: #4285f4;
      width: 85%;
    }

    .green-fill {
      background-color: #34a853;
      width: 75%;
    }

    .yellow-fill {
      background-color: #fbbc05;
      width: 85%;
    }

    @media (max-width: 768px) {
      .my-navbar {
        padding: 0.75rem 1rem;
      }

      .main-section {
        padding: 1rem;
      }

      .stats-grid {
        grid-template-columns: 1fr;
      }
    }
  </style>
  
  <link rel="icon" type="image/x-icon" href="../images/new_favicon.jpeg">
</head>
<body>
  <div class="my-navbar">
    <div class="user-profile">
      <a href="/tr-profile"><img id="user-pfp" src="../images/teacher-profile.jpg" alt="user-pfp"></a>
      <div class="user-name">Teacher Name</div>
    </div>
    <div class="navbar-center-section">
      <div>Teacher Dashboard</div>
    </div>
    <div class="navbar-icons">
      <i class="fa-solid fa-bell nav-icon"></i>
      <i class="fa-solid fa-phone nav-icon"></i>
      <button id="logout-btn"><a href="logout">Logout</a></button>
    </div>
  </div>
  
  <div class="thought-section">
    <div class="thought-box">
      <span class="quote-mark left">"</span>
      <p>Education is not the filling of a pail, but the lighting of a fire.</p>
      <span class="author">— William Butler Yeats</span>
      <span class="quote-mark right">"</span>
    </div>
  </div>

  <div class="container mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Updates Section -->
      <div class="dashboard-section col-span-1">
        <h3>Updates</h3>
        <div class="update-item">
          <div class="update-title">New Fee Payment</div>
          <div class="update-desc">Student John Doe paid semester fees</div>
          <div class="update-time">2 minutes ago</div>
        </div>
        <div class="update-item">
          <div class="update-title">Attendance Alert</div>
          <div class="update-desc">3 students below 75% attendance</div>
          <div class="update-time">1 hour ago</div>
        </div>
        <div class="update-item">
          <div class="update-title">New Admission</div>
          <div class="update-desc">2 new students enrolled today</div>
          <div class="update-time">3 hours ago</div>
        </div>
        <div class="update-item">
          <div class="update-title">Schedule Change</div>
          <div class="update-desc">Friday's class rescheduled to 5 PM</div>
          <div class="update-time">Yesterday</div>
        </div>
      </div>

      <!-- Stats Section -->
      <div class="col-span-2">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <!-- Attendance Card -->
          <div class="stats-card purple">
            <div class="stats-header">
              <div class="stats-title">Attendance</div>
              <div class="stats-icon"><i class="fa-solid fa-users"></i></div>
            </div>
            <div class="stats-subheader">Today's Status</div>
            <div class="stats-info">
              <div class="stats-label">Present: 42</div>
              <div class="stats-number">Total: 45</div>
            </div>
            <div class="progress-bar">
              <div class="progress-fill purple-fill"></div>
            </div>
          </div>

          <!-- Fees Collection Card -->
          <div class="stats-card blue">
            <div class="stats-header">
              <div class="stats-title">Fees Collection</div>
              <div class="stats-icon"><i class="fa-solid fa-indian-rupee-sign"></i></div>
            </div>
            <div class="stats-subheader">This Month</div>
            <div class="stats-info">
              <div class="stats-label">Collected: ₹85,000</div>
              <div class="stats-number">Pending: ₹15,000</div>
            </div>
            <div class="progress-bar">
              <div class="progress-fill blue-fill"></div>
            </div>
          </div>

          <!-- Today's Schedule Card -->
          <div class="stats-card green">
            <div class="stats-header">
              <div class="stats-title">Today's Schedule</div>
              <div class="stats-icon"><i class="fa-solid fa-calendar-day"></i></div>
            </div>
            <div class="stats-info">
              <div class="stats-label">4 Classes Remaining</div>
              <div class="stats-number">Next: 10:30 AM</div>
            </div>
            <div class="stats-subheader mt-2">Next: Mathematics</div>
            <div class="progress-bar">
              <div class="progress-fill green-fill"></div>
            </div>
          </div>

          <!-- Class Performance Card -->
          <div class="stats-card yellow">
            <div class="stats-header">
              <div class="stats-title">Class Performance</div>
              <div class="stats-icon"><i class="fa-solid fa-chart-line"></i></div>
            </div>
            <div class="stats-subheader">This Semester</div>
            <div class="stats-info">
              <div class="stats-label">Average Score: 85%</div>
              <div class="stats-number">Target: 90%</div>
            </div>
            <div class="progress-bar">
              <div class="progress-fill yellow-fill"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Quick Access Cards -->
    <div class="main-section mt-6">
      <div class="card">
        <div class="p-4 flex justify-center">
          <i class="fa-solid fa-book text-5xl text-gray-700"></i>
        </div>
        <div class="p-4 text-center font-medium">Manage Classes</div>
      </div>
      
      <div class="card">
        <div class="p-4 flex justify-center">
          <i class="fa-solid fa-user-graduate text-5xl text-gray-700"></i>
        </div>
        <div class="p-4 text-center font-medium">Student Records</div>
      </div>
      
      <div class="card">
        <div class="p-4 flex justify-center">
          <i class="fa-solid fa-clipboard-check text-5xl text-gray-700"></i>
        </div>
        <div class="p-4 text-center font-medium">Attendance</div>
      </div>
      
      <div class="card">
        <div class="p-4 flex justify-center">
          <i class="fa-solid fa-calendar-alt text-5xl text-gray-700"></i>
        </div>
        <div class="p-4 text-center font-medium">Schedule</div>
      </div>
    </div>
  </div>

  <footer class="bg-gray-200 text-gray-600 py-6">
    <div class="container mx-auto flex flex-wrap justify-center text-center">
      <div class="w-full sm:w-1/4 mb-4 sm:mb-0 px-4">
        <h3 class="text-lg font-medium mb-2">About Us</h3>
        <p class="text-sm">Learn more about Nrutyashree Dance Academy and our mission.</p>
        <a href="#" class="text-blue-500 hover:text-blue-600 text-sm">Read More</a>
      </div>
      <div class="w-full sm:w-1/4 mb-4 sm:mb-0 px-4">
        <h3 class="text-lg font-medium mb-2">Quick Links</h3>
        <ul class="list-none text-sm">
          <li><a href="#" class="text-gray-500 hover:text-gray-600">Home</a></li>
          <li><a href="#" class="text-gray-500 hover:text-gray-600">Dashboard</a></li>
          <li><a href="#" class="text-gray-500 hover:text-gray-600">Contact</a></li>
        </ul>
      </div>
      <div class="w-full sm:w-1/4 mb-4 sm:mb-0 px-4">
        <h3 class="text-lg font-medium mb-2">Contact Us</h3>
        <p class="text-sm text-gray-500">
          Sipa Dance Academy<br>
          BT Kawade Road<br>
          Ghorpadi, Pune<br>
          Phone: +91 9822155819
        </p>
      </div>
      <div class="w-full sm:w-1/4 mb-4 sm:mb-0 px-4">
        <h3 class="text-lg font-medium mb-2">Follow Us</h3>
        <div class="flex justify-center">
          <a href="#" class="text-gray-500 hover:text-gray-600 mx-2">
            <i class="fab fa-facebook-f"></i>
          </a>
          <a href="#" class="text-gray-500 hover:text-gray-600 mx-2">
            <i class="fab fa-twitter"></i>
          </a>
          <a href="#" class="text-gray-500 hover:text-gray-600 mx-2">
            <i class="fab fa-linkedin-in"></i>
          </a>
          <a href="#" class="text-gray-500 hover:text-gray-600 mx-2">
            <i class="fab fa-instagram"></i>
          </a>
        </div>
      </div>
    </div>
    <div class="bg-gray-300 py-4 mt-6">
      <div class="container mx-auto text-center text-gray-500 text-sm">
        &copy; 2008 Nrutyashree Dance Academy. All rights reserved.
      </div>
    </div>
  </footer>

  <script>
    // You can add your JavaScript functionality here
    document.addEventListener('DOMContentLoaded', function() {
      // Any initialization code can go here
      console.log('Teacher Dashboard loaded');
    });
  </script>
</body>
</html>