<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NDA - Sign Up</title>
    <link rel="stylesheet" href="../stylesheets/signup.css">
    <link rel="icon" type="favicon" href="../images/nda-favicon-v2.png">
<body>
    <% if (error && error.length > 0) { %>
        <div class="error-message" id="flash-error">
            <%= error %>
            <button class="flash-close" aria-label="Close message">&times;</button>
        </div>
    <% } %>

    <div class="container">
        <div class="welcome-section">
            <img src="../images/natraj-logo.png" alt="Nrutyashree Logo" class="logo">
            <h1>Welcome to<br>Nrutyashree Dance Academy!</h1>
            <p>Discover the art of classical dance</p>
        </div>
        
        <div class="form-section">
            <h2>Register</h2>
            <p>Please complete the registration form</p>
            
           <form action="/signup" method="post">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" value="<%= formData ? formData.name : '' %>" required>
                </div>
                
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" value="<%= formData ? formData.email : '' %>" required>
                </div>
                
                <div class="form-group">
                    <label for="birthdate">Date of Birth</label>
                    <input type="date" id="birthdate" name="birthdate" required onchange="calculateAge()">
                </div>
                
                <div class="form-group">
                    <label for="age">Age</label>
                    <input type="number" id="age" name="age" readonly required>
                </div>
                
                <div class="form-group">
                    <label for="student_ph_no">Student Phone Number</label>
                    <input type="tel" id="student_ph_no" name="student_ph_no" value="<%= formData ? formData.student_ph_no : '' %>" required>
                </div>
                
                <div class="form-group">
                    <label for="exam_level">Exam Level</label>
                    <select id="exam_level" name="exam_level" required>
                        <option value="">Select your level</option>
                        <option value="Prarambhik">Regular Student</option>
                        <option value="Prarambhik">Prarambhik</option>
                        <option value="Praveshika Pratham">Praveshika Pratham</option>
                        <option value="Praveshika-Purna">Praveshika Purna</option>
                        <option value="Madhyama Pratham">Madhyama Pratham</option>
                        <option value="Madhyama Purna">Madhyama Purna</option>
                        <option value="Visharad-Pratham">Visharad Pratham</option>
                        <option value="Visharad Purna">Visharad Purna</option>
                        <option value="Alankar Pratham">Alankar Pratham</option>
                        <option value="Alankar Purna">Alankar Purna</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="mother_ph_no">Mother's Phone Number</label>
                    <input type="tel" id="mother_ph_no" name="mother_ph_no" value="<%= formData ? formData.mother_ph_no : '' %>" required>
                </div>
                
                <div class="form-group">
                    <label for="father_ph_no">Father's Phone Number</label>
                    <input type="tel" id="father_ph_no" name="father_ph_no" value="<%= formData ? formData.father_ph_no : '' %>" required>
                </div>
                
                <div class="form-group">
                    <label for="password">Password</label>
                    <input type="password" id="password" name="password" value="<%= formData ? formData.password : '' %>" required>
                </div>
                
                <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <input type="password" id="confirmPassword" name="confirmPassword" value="<%= formData ? formData.confirmPassword : '' %>" required>
                </div>
                
                <button type="submit">Sign Up</button>
            </form>
            
            <div class="login-link">
                Already have an account? <a href="/login">Login</a>
            </div>
        </div>
    </div>

    <script src="../javascripts/notifications.js"></script>
    <script src="../javascripts/signup.js"></script>
</body>
</html>