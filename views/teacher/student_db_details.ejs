<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Details | NDA</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../stylesheets/student_db_details.css">
    <link rel="stylesheet" href="../stylesheets/dashboard-back-button.css">
    <link rel="icon" type="image/png" href="../images/favicon-2.0.3/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../images/favicon-2.0.3/favicon.svg" />
    <link rel="shortcut icon" href="../images/favicon-2.0.3/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon-2.0.3/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Nrutyashree" />
    <link rel="manifest" href="../images/favicon-2.0.3/site.webmanifest" />
</head>
<body>
    <%- include('../partials/dashboard-back-button', { fallbackHref: '/teacher-dashboard' }) %>
    <div class="floating-particles">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>

    <div class="container">
                 <%
            const monthNames = [
                'January', 'February', 'March', 'April', 'May', 'June',
                'July', 'August', 'September', 'October', 'November', 'December'
            ];
            const selectedYearValue = typeof selectedYear !== 'undefined' ? selectedYear : (payment && payment.year ? payment.year : new Date().getFullYear());
            const year = selectedYearValue || new Date().getFullYear();
      const quarterNames = ['Q1 (Jan-Mar)', 'Q2 (Apr-Jun)', 'Q3 (Jul-Sep)', 'Q4 (Oct-Dec)'];
      const halfYearlyNames = [
        { id: 'half1', name: 'H1 (Jan-Jun)', months: 'January, February, March, April, May, June' },
        { id: 'half2', name: 'H2 (Jul-Dec)', months: 'July, August, September, October, November, December' }
      ];
    %>
        <!-- Student Profile Section -->
        <div class="student-profile">
            <div class="search-icon">
                <i class="fas fa-search"></i>
            </div>
            
            <div class="profile-header">
                <div class="profile-header__name">
                    <h1 class="profile-name">
                        <%= student.name %>
                    </h1>
                    <span class="exam-level" style="display:inline-block;margin-top:0.5rem;background:linear-gradient(135deg,#6c5ce7 0%,#8e44ad 100%);color:white;padding:0.3rem 0.9rem;border-radius:20px;font-size:0.85rem;font-weight:600;">
                        <%= student.exam_level %>
                    </span>
                </div>
            </div>
            
            <div class="year-selector" aria-label="Select academic year">
                <div class="year-selector__label">
                    <span>Academic Year</span>
                    <small>Switch between batches</small>
                </div>
                <div class="year-selector__control">
                    <i class="fa-solid fa-calendar-days" aria-hidden="true"></i>
                    <select id="yearSelect">
                        <% (availableYears && availableYears.length ? availableYears : [year]).forEach(function(y) { %>
                            <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
                        <% }) %>
                    </select>
                </div>
            </div>

            <div class="profile-details">
                <div class="detail-item">
                    <span class="detail-label">Age:</span>
                    <span><%= student.age %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Phone:</span>
                    <span><%= student.student_ph_no %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">Exam:</span>
                    <span><%= student.exam_level %></span>
                </div>
                <div class="detail-item">
                    <span class="detail-label">DOB:</span>
                    <span><%= student.birthdate ? new Date(student.birthdate).toLocaleDateString() : '' %></span>
                </div>
            </div>
        </div>

        <!-- Fee Status Section -->
        <div class="fee-section">
            <div class="fee-header"> 
                <h2 class="fee-title">FEE STATUS</h2>
                <div class="fee-toggle">
                    <button class="toggle-btn active" id="monthsBtn">Months</button>
                    <button class="toggle-btn" id="quartersBtn">Quarter</button>
                    <button class="toggle-btn" id="halfYearlyBtn">Half-Yearly</button>
                </div>
            </div>
            <div class="fee-meta">
                <div class="meta-card" style="position: relative;">
                    <span class="meta-label">Current Fee</span>
                    <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <span class="meta-value">₹ <span id="currentFeeDisplay"><%= student.exam_fee %></span></span>
                        <button id="editFeeBtn" style="background: linear-gradient(135deg, #6c5ce7 0%, #8e44ad 100%); color: white; border: none; padding: 0.4rem 0.8rem; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 600; display: flex; align-items: center; gap: 0.3rem; transition: transform 0.2s, box-shadow 0.2s;">
                            <i class="fas fa-edit"></i> Edit
                        </button>
                    </div>
                </div>
                <!-- <div class="meta-card highlight">
                    <span class="meta-label">Showing Year</span>
                    <span class="meta-value"><%= year %></span>
                </div> -->
            </div>
            <% if (!payment) { %>
                <div role="status" style="margin-top:0.75rem;padding:0.85rem 1rem;border-radius:12px;background:#fff8e1;border:1px solid #ffd98c;color:#8a6d3b;font-weight:500;">
                    No payment records found for <strong><%= year %></strong>. Select another year to review historical payments.
                </div>
            <% } %>
            <div class="fee-list" id="monthsList">
                <% for(let i = 0; i < 12; i++) { 
                    const status = payment && payment.months && (payment.months[i] || (payment.months.get && payment.months.get(String(i)))) || 'Pending';
                    const paid = status === 'Paid';
                %>
                    <div class="fee-item <%= paid ? 'paid' : 'unpaid' %>">
                        <span class="fee-month"><%= monthNames[i] %> <%= year %></span>
                        <% if (!paid) { %>
                            <a href="/update-fee?studentId=<%= student.id %>&year=<%= year %>&month=<%= i %>&isQuarterly=false">
                                <button class="edit-btn">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
            <div class="fee-list" id="quartersList" style="display:none;">
                <% for(let q = 1; q <= 4; q++) { 
                    const status = payment && payment.quarters && (payment.quarters[q] || (payment.quarters.get && payment.quarters.get(String(q)))) || 'Pending';
                    const paid = status === 'Paid';
                %>
                    <div class="fee-item <%= paid ? 'paid' : 'unpaid' %>">
                        <span class="fee-month"><%= quarterNames[q-1] %> <%= year %></span>
                        <% if (!paid) { %>
                            <a href="/update-fee?studentId=<%= student.id %>&year=<%= year %>&quarter=<%= q %>&isQuarterly=true">
                                <button class="edit-btn">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </a>
                        <% } %>
                    </div>
                <% } %>
            </div>
            <div class="fee-list" id="halfYearlyList" style="display:none;">
                <% halfYearlyNames.forEach(function(half) { 
                    const status = payment && payment.halfyearly && (payment.halfyearly[half.id] || (payment.halfyearly.get && payment.halfyearly.get(half.id))) || 'Pending';
                    const paid = status === 'Paid';
                %>
                    <div class="fee-item <%= paid ? 'paid' : 'unpaid' %>">
                        <div>
                            <span class="fee-month"><%= half.name %> <%= year %></span>
                            <div style="font-size: 0.75rem; color: #666; margin-top: 0.25rem;"><%= half.months %></div>
                        </div>
                        <% if (!paid) { %>
                            <a href="/update-fee?studentId=<%= student.id %>&year=<%= year %>&halfId=<%= half.id %>&isHalfYearly=true">
                                <button class="edit-btn">
                                    <i class="fas fa-edit"></i>
                                </button>
                            </a>
                        <% } %>
                    </div>
                <% }); %>
            </div>
        </div>

        <!-- Edit Fee Modal -->
        <div id="editFeeModal" style="display: none; position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0, 0, 0, 0.6); z-index: 1000; align-items: center; justify-content: center;">
            <div style="background: white; padding: 2rem; border-radius: 15px; box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2); max-width: 400px; width: 90%; animation: slideUp 0.3s ease-out;">
                <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.5rem;">
                    <h3 style="margin: 0; font-size: 1.3rem; color: #333;">Update Student Fee</h3>
                    <button id="closeFeeModal" type="button" style="background: none; border: none; font-size: 1.5rem; cursor: pointer; color: #999;">✕</button>
                </div>
                
                <div style="margin-bottom: 1.5rem;">
                    <label style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #555;">Student Name:</label>
                    <p style="margin: 0; color: #333; font-weight: 500;"><%= student.name %></p>
                </div>

                <div style="margin-bottom: 1.5rem;">
                    <label for="newFeeInput" style="display: block; margin-bottom: 0.5rem; font-weight: 600; color: #555;">New Fee Amount (₹):</label>
                    <input type="number" id="newFeeInput" min="0" step="10" style="width: 100%; padding: 0.8rem; border: 2px solid #e0e0e0; border-radius: 8px; font-size: 1rem; box-sizing: border-box; transition: border-color 0.2s;" value="<%= student.exam_fee %>">
                    <small style="color: #999; margin-top: 0.3rem; display: block;">Enter the new fee amount</small>
                </div>

                <div style="display: flex; gap: 1rem; justify-content: flex-end;">
                    <button id="cancelFeeBtn" type="button" style="background: #e0e0e0; color: #333; border: none; padding: 0.8rem 1.5rem; border-radius: 8px; cursor: pointer; font-weight: 600; transition: background 0.2s;">Cancel</button>
                    <button id="saveFeeBtn" type="button" style="background: linear-gradient(135deg, #6c5ce7 0%, #8e44ad 100%); color: white; border: none; padding: 0.8rem 1.5rem; border-radius: 8px; cursor: pointer; font-weight: 600; transition: transform 0.2s, box-shadow 0.2s;">Save Fee</button>
                </div>

                <div id="feeErrorMsg" style="margin-top: 1rem; padding: 0.8rem; border-radius: 8px; background: #fee; color: #c33; display: none; font-size: 0.9rem;"></div>
                <div id="feeSuccessMsg" style="margin-top: 1rem; padding: 0.8rem; border-radius: 8px; background: #efe; color: #3c3; display: none; font-size: 0.9rem;"></div>
            </div>
        </div>

        <style>
            @keyframes slideUp {
                from {
                    transform: translateY(20px);
                    opacity: 0;
                }
                to {
                    transform: translateY(0);
                    opacity: 1;
                }
            }

            #editFeeModal.show {
                display: flex !important;
            }

            #editFeeBtn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(108, 92, 231, 0.4);
            }

            #newFeeInput:focus {
                outline: none;
                border-color: #6c5ce7;
                box-shadow: 0 0 0 3px rgba(108, 92, 231, 0.1);
            }

            #saveFeeBtn:hover {
                transform: translateY(-2px);
                box-shadow: 0 4px 12px rgba(108, 92, 231, 0.4);
            }

            #cancelFeeBtn:hover {
                background: #d0d0d0;
            }
        </style>

    </div>
    <script>
        // Toggle between months, quarters, and half-yearly
        document.addEventListener('DOMContentLoaded', function() {
            const monthsBtn = document.getElementById('monthsBtn');
            const quartersBtn = document.getElementById('quartersBtn');
            const halfYearlyBtn = document.getElementById('halfYearlyBtn');
            const monthsList = document.getElementById('monthsList');
            const quartersList = document.getElementById('quartersList');
            const halfYearlyList = document.getElementById('halfYearlyList');
            const yearSelect = document.getElementById('yearSelect');
            
            monthsBtn.addEventListener('click', function() {
                monthsBtn.classList.add('active');
                quartersBtn.classList.remove('active');
                halfYearlyBtn.classList.remove('active');
                monthsList.style.display = '';
                quartersList.style.display = 'none';
                halfYearlyList.style.display = 'none';
            });
            
            quartersBtn.addEventListener('click', function() {
                quartersBtn.classList.add('active');
                monthsBtn.classList.remove('active');
                halfYearlyBtn.classList.remove('active');
                monthsList.style.display = 'none';
                quartersList.style.display = '';
                halfYearlyList.style.display = 'none';
            });
            
            halfYearlyBtn.addEventListener('click', function() {
                halfYearlyBtn.classList.add('active');
                monthsBtn.classList.remove('active');
                quartersBtn.classList.remove('active');
                monthsList.style.display = 'none';
                quartersList.style.display = 'none';
                halfYearlyList.style.display = '';
            });

            if (yearSelect) {
                yearSelect.addEventListener('change', function() {
                    const params = new URLSearchParams(window.location.search);
                    params.set('year', yearSelect.value);
                    window.location.href = `/student-db-details/<%= student.id %>?${params.toString()}`;
                });
            }

            // Fee Edit Modal Logic
            const editFeeBtn = document.getElementById('editFeeBtn');
            const editFeeModal = document.getElementById('editFeeModal');
            const closeFeeModal = document.getElementById('closeFeeModal');
            const cancelFeeBtn = document.getElementById('cancelFeeBtn');
            const saveFeeBtn = document.getElementById('saveFeeBtn');
            const newFeeInput = document.getElementById('newFeeInput');
            const feeErrorMsg = document.getElementById('feeErrorMsg');
            const feeSuccessMsg = document.getElementById('feeSuccessMsg');
            const currentFeeDisplay = document.getElementById('currentFeeDisplay');

            // Open modal
            editFeeBtn.addEventListener('click', function() {
                newFeeInput.value = '<%= student.exam_fee %>';
                feeErrorMsg.style.display = 'none';
                feeSuccessMsg.style.display = 'none';
                editFeeModal.classList.add('show');
            });

            // Close modal functions
            function closeModal() {
                editFeeModal.classList.remove('show');
                feeErrorMsg.style.display = 'none';
                feeSuccessMsg.style.display = 'none';
            }

            closeFeeModal.addEventListener('click', closeModal);
            cancelFeeBtn.addEventListener('click', closeModal);

            // Close modal when clicking outside
            editFeeModal.addEventListener('click', function(e) {
                if (e.target === editFeeModal) {
                    closeModal();
                }
            });

            // Save fee
            saveFeeBtn.addEventListener('click', async function() {
                const newFee = parseFloat(newFeeInput.value);

                // Validation
                if (!newFeeInput.value.trim()) {
                    showError('Please enter a fee amount');
                    return;
                }

                if (newFee <= 0) {
                    showError('Fee must be a positive number');
                    return;
                }

                saveFeeBtn.disabled = true;
                saveFeeBtn.innerText = 'Saving...';

                try {
                    const response = await fetch(`/student-db-details/<%= student.id %>/update-exam-fee`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ 
                            newFee: newFee 
                        })
                    });

                    const data = await response.json();

                    if (data.success) {
                        currentFeeDisplay.innerText = newFee;
                        showSuccess(`Fee updated successfully to ₹ ${newFee}`);
                        setTimeout(closeModal, 1500);
                    } else {
                        showError(data.message || 'Failed to update fee');
                    }
                } catch (error) {
                    console.error('Error:', error);
                    showError('An error occurred. Please try again.');
                } finally {
                    saveFeeBtn.disabled = false;
                    saveFeeBtn.innerText = 'Save Fee';
                }
            });

            function showError(msg) {
                feeErrorMsg.innerText = msg;
                feeErrorMsg.style.display = 'block';
                feeSuccessMsg.style.display = 'none';
            }

            function showSuccess(msg) {
                feeSuccessMsg.innerText = msg;
                feeSuccessMsg.style.display = 'block';
                feeErrorMsg.style.display = 'none';
            }

            // Allow Enter key to save
            newFeeInput.addEventListener('keypress', function(e) {
                if (e.key === 'Enter') {
                    saveFeeBtn.click();
                }
            });
        });
    </script>
    
    <!-- Auto-refresh fee collection on payment updates -->
    <script src="../javascripts/paymentRefreshTrigger.js"></script>
   
</body>
</html>