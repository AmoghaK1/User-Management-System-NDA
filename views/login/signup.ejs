<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | NDA</title>
    <link rel="stylesheet" href="../stylesheets/signup.css">
    <link rel="stylesheet" href="../stylesheets/notifications.css">
    <link rel="icon" type="image/png" href="../images/favicon-2.0.3/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../images/favicon-2.0.3/favicon.svg" />
    <link rel="shortcut icon" href="../images/favicon-2.0.3/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon-2.0.3/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Nrutyashree" />
    <link rel="manifest" href="../images/favicon-2.0.3/site.webmanifest" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>

<body>
    <% if (typeof error !== 'undefined' && error) { %>
        <div class="error-message" id="flash-error">
            <%= error %>
            <button class="flash-close" aria-label="Close message">&times;</button>
        </div>
    <% } %>
    
    <% if (typeof success !== 'undefined' && success) { %>
        <div class="success-message" id="flash-success">
            <%= success %>
            <button class="flash-close" aria-label="Close message">&times;</button>
        </div>
    <% } %> 

    <div class="container">
        <div class="welcome-section">
            <img src="../images/natraj-logo.png" alt="Nrutyashree Logo" class="logo">
            <h1>Welcome to<br>Nrutyashree Dance Academy!</h1>
            <p>Discover the art of classical dance</p>
        </div>
        
        <div class="form-section">
            <h2>Register</h2>
            <p>Please complete the registration form to start learning with us.</p>
            
           <form action="/signup" method="post">
                <div class="form-group">
                    <label for="name">Full Name</label>
                    <input type="text" id="name" name="name" autocomplete="name" value="<%= typeof formData !== 'undefined' ? formData.name : '' %>" required>
                </div>
                
                <div class="form-group">
                    <label for="email">Email Address</label>
                    <input type="email" id="email" name="email" autocomplete="email" value="<%=typeof formData !== 'undefined' ? formData.email : '' %>" required>
                </div>
                
                <div class="form-group">
                    <label for="birthdate">Date of Birth</label>
                    <input type="date" id="birthdate" name="birthdate" autocomplete="bday" required onchange="calculateAge()">
                </div>
                
                <div class="form-group">
                    <label for="age">Age</label>
                    <input type="number" id="age" name="age" readonly required>
                </div>
                
                <div class="form-group">
                    <label for="student_ph_no">Parent / Student Phone Number <small style="display:block;color:#6b7280;">(We will use this to contact you.)</small></label>
                    <input type="tel" id="student_ph_no" name="student_ph_no" autocomplete="tel" placeholder="e.g. +91XXXXXXXXXX" value="<%= typeof formData !== 'undefined' ? formData.student_ph_no : '' %>" required>
                </div>
                
                <div class="form-group">
                    <label for="exam_level">Exam Level</label>
                    <select id="exam_level" name="exam_level" required>
                        <option value="">Select your level</option>
                        <option value="Senior Batch">Senior Batch</option>
                        <option value="Prarambhik">Prarambhik - 1st exam</option>
                        <option value="Praveshika Pratham">Praveshika Pratham - 2nd exam</option>
                        <option value="Praveshika Purna">Praveshika Purna - 3rd exam</option>
                        <option value="Madhyama Pratham">Madhyama Pratham - 4th exam</option>
                        <option value="Madhyama Purna">Madhyama Purna - 5th exam</option>
                        <option value="Visharad Pratham">Visharad Pratham - 6th exam</option>
                        <option value="Visharad Purna">Visharad Purna - 7th exam</option>
                        <option value="Alankar Pratham">Alankar Pratham - 8th exam</option>
                        <option value="Alankar Purna">Alankar Purna - 9th exam</option>
                        <option value="TMA-BA">TMA-BA</option>
                    </select>
                </div>
                
                <div class="form-group">
                    <label for="password">Password <small style="color: #666; font-size: 0.90em;">(min. 5 characters and 1 number)</small></label>
                    <div class="input-wrapper">
                      <input type="password" id="password" name="password" autocomplete="new-password" value="<%=typeof formData != "undefined" ? formData.password : '' %>" required>
                      <i class="fa-solid fa-eye" id="togglePassword"></i>
                    </div>
                  </div>
                  
                  <div class="form-group">
                    <label for="confirmPassword">Confirm Password</label>
                    <div class="input-wrapper">
                      <input type="password" id="confirmPassword" name="confirmPassword" autocomplete="new-password" value="<%= typeof formData !== "undefined" ? formData.confirmPassword : '' %>" required>
                      <i class="fa-solid fa-eye" id="toggleConfirmPassword"></i>
                    </div>
                  </div>
                
                <button type="submit">Sign Up</button>
            </form>
            
            <div class="login-link">
                Already have an account? <a href="/login">Login</a>
            </div>
        </div>
    </div>

    <script src="../javascripts/notifications.js"></script>
    <script src="../javascripts/signup.js"></script>
</body>
</html>