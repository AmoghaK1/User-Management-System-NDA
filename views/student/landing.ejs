<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nrutyashree Dance Academy</title>
    <link rel="stylesheet" href="../stylesheets/landing.css">
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;700&family=Playfair+Display:wght@400;700&display=swap" rel="stylesheet">
    <link rel="icon" type="image/png" href="../images/favicon-2.0.3/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../images/favicon-2.0.3/favicon.svg" />
    <link rel="shortcut icon" href="../images/favicon-2.0.3/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon-2.0.3/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Nrutyashree" />
    <link rel="manifest" href="../images/favicon-2.0.3/site.webmanifest" />
</head>
<body>
    <!-- Navigation -->
    <nav class="navbar">
        <div class="container">
            <img src="../images/natraj-logo.png" alt="natraj-logo" class="natraj-logo">
            <h1 class="logo">Nrutyashree</h1>
            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#classes">Classes</a></li>
                <li><a href="#gallery">Gallery</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </div>
    </nav>

    <!-- Hero Section -->
    <section id="home" class="hero">
        <div class="hero-overlay"></div>
        <div class="hero-content">
            <h2 class="hero-title">Nrutyashree Dance Academy</h2>
            <p class="hero-subtitle">Where Tradition Meets Grace</p>
            <a href="#contact" class="cta-button">Begin Your Journey</a>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="about">
        <div class="container">
            <h2 class="section-title">Our Legacy</h2>
            <div class="about-content">
                <p>Nrutyashree Dance Academy is a sanctuary of Bharatanatyam, where every gesture tells a story and every rhythm echoes tradition. Our expert gurus guide you through the divine art form with elegance and devotion.</p>
                <div class="signature">
                    <img src="../images/nda favicon.png" alt="Signature" class="signature-img">
                </div>
            </div>
        </div>
    </section>

    <!-- Classes Section -->
    <section id="classes" class="classes">
        <div class="container">
            <h2 class="class-section-title">Our Offerings</h2>
            <div class="classes-grid">
                <div class="class-card">
                    <h3>Beginner</h3>
                    <p>Start your Bharatanatyam journey with foundational steps and grace.</p>
                </div>
                <div class="class-card">
                    <h3>Intermediate</h3>
                    <p>Enhance your skills with intricate movements and expressions.</p>
                </div>
                <div class="class-card">
                    <h3>Advanced</h3>
                    <p>Master the art with professional training and performances.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Gallery Section -->
    <section id="gallery" class="gallery">
        <div class="container">
            <h2 class="section-title">Moments of Grace</h2>
            <div class="gallery-carousel">
                <div class="gallery-item" style="background-image: url('../images/img3.jpeg');"></div>
                <div class="gallery-item" style="background-image: url('../images/img2.jpeg');"></div>
                <div class="gallery-item" style="background-image: url('../images/natraj-logo.png');"></div>
            </div>
        </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="contact">
        <div class="container">
            <h2 class="contact-section-title">Reach Out</h2>
            <form class="contact-form">
                <input type="text" placeholder="Your Name" required>
                <input type="email" placeholder="Your Email" required>
                <textarea placeholder="Your Message" required></textarea>
                <button type="submit" class="cta-button">Send</button>
            </form>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <p>© 2025 Nrutyashree Dance Academy | Crafted with Tradition</p>
    </footer>
</body>
</html>