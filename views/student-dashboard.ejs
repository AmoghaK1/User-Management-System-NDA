<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Student Dashboard</title>
  
  <!-- <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.1.3/css/bootstrap.min.css" rel="stylesheet"> -->
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link href="https://cdn.jsdelivr.net/npm/tailwindcss@2.2.19/dist/tailwind.min.css" rel="stylesheet">

  <link rel="stylesheet" href="../stylesheets/stdashboard.css">
  <link rel="icon" type="favicon" href="../images/new_favicon.jpeg">
</head>
<body>
    <div class="my-navbar">
        <div class="user-profile">
            <a href="/st-profile"><img id="user-pfp" src= <%= user.profilePicture %> alt="user-pfp"></a>
            <div class="user-name"><%= user.name %></div>
        </div>
        <div class="navbar-center-section">
            <div><%= user.exam_level %></div>
        </div>
        <div class="navbar-icons">
            <i class="fa-solid fa-bell nav-icon"></i>
            <a href="tel:+919822155819"><i class="fa-solid fa-phone nav-icon"></i></a>
            <button id="logout-btn"><a href="logout">Logout</a></button>
        </div>
    </div>
    <div class="navbar-mobile">
        <div class="exam-name"><%= user.exam_level %></div>
    </div>
   
    <div class="thought-section">
      
        <div class="thought-box">
          <p></p>
          <span class="author"></span> 
        </div>
       
    </div>

   <div class="main-section">
    <a href="/study">
    <div class="card">
        <div class="card-image">
            <img src="../images/study-material.png" alt="study material img">
        </div>
        <div class="card-text"><button>Study Material</button></div>
    </div>
  </a>
    <a href="/accounts">
    <div class="card">
        <div class="card-image">
            <img src="../images/bank.png" alt="accounts img">
        </div>
        <div class="card-text">Fees And Payment</div>
    </div>
  </a>
   <a href="/events">
    <div class="card">
        <div class="card-image">
            <img src="../images/events_nda.png" alt="events img">
        </div>
        <div class="card-text">Events</div>
    </div>
  </a>

  <a href="/certificates">
    <div class="card">
        <div class="card-image">
            <img src="../images/certificate_nda.png" alt="Certificate img">
        </div>
        <div class="card-text">Certificate</div>
    </div>
  </div>
</a>

<footer>
  <div class="footer-container">
      <div class="footer-section">
          <h3>About Us</h3>
          <p>Nrutyashree Dance Academy - Preserving and promoting Indian classical dance forms.</p>
         
      </div>
      
      <div class="footer-section">
          <h3>Quick Links</h3>
          <ul class="footer-links">
              <li><a href="/">Home</a></li>
              <li><a href="/study">Study Material</a></li>
              <li><a href="/events">Events</a></li>
              <li><a href="/accounts">Accounts</a></li>
          </ul>
      </div>
      
      <div class="footer-section">
          <h3>Contact</h3>
          <p>
              <i class="fas fa-map-marker-alt"></i> 2nd Floor, Wide Angel Building <Br> 
                BT Kawade Road, Ghorpadi, <br>
                Pune, Maharashtra <br>
                Pin Code: 411036
          </p>
          <p>
              <i class="fas fa-phone"></i> +91 9822155819
          </p>
          <p>
              <i class="fas fa-envelope"></i> info.nrutyashree@gmail.com
          </p>
      </div>
      
      <div class="footer-section">
          <h3>Follow Us</h3>
          <div class="social-links">
              <a href="https://www.facebook.com/rajshree.khare1"><i class="fab fa-facebook-f"></i></a>
              <a href="https://www.instagram.com/nrutyashree_dance_academy/"><i class="fab fa-instagram"></i></a>
              <a href="https://wa.me/+919822155819" target="_blank"><i class="fab fa-whatsapp"></i></a>
          </div>
      </div>
  </div>
  
  <div class="copyright">
      &copy; 2009 Nrutyashree Dance Academy. All rights reserved.
  </div>
</footer>
  <script src="../javascripts/st-dashboard.js"></script>
</body>
</html>