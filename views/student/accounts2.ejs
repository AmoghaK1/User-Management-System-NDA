<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Fee Payment | NDA</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link rel="icon" type="image/png" href="../images/favicon-2.0.3/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../images/favicon-2.0.3/favicon.svg" />
    <link rel="shortcut icon" href="../images/favicon-2.0.3/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon-2.0.3/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Nrutyashree" />
    <link rel="manifest" href="../images/favicon-2.0.3/site.webmanifest" />
</head>
<body class="min-h-screen bg-gray-50 p-6">
    <div class="max-w-4xl mx-auto">
        <!-- Header -->
        <div class="flex items-center mb-8">
            <img class="w-12 h-12 rounded-full bg-gray-200" src=<%= user.profilePicture %> alt="Profile">
            <div class="ml-3">
                <span class="text-2xl font-bold text-gray-800"><%= user.name %></span>
                <div class="text-lg text-gray-500"><%= user.exam_level %></div>
            </div>
        </div>

        <!-- Fee Payment Selection -->
        <div class="flex flex-col items-center justify-center py-16">
            <h2 class="text-3xl font-bold text-gray-800 mb-10">Fee Payment</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-8 w-full max-w-3xl">
                <!-- Quarterly Payment Button -->
                <a href="/quarterly-payments" class="bg-white border-2 border-purple-600 hover:bg-purple-50 rounded-xl shadow-md p-8 flex flex-col items-center transition-all duration-300 cursor-pointer">
                    <svg class="w-16 h-16 text-purple-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01"></path>
                    </svg>
                    <h3 class="text-xl font-semibold text-gray-800 mb-2">Quarterly Payments</h3>
                    <p class="text-gray-600 text-center">Pay ₹<%= user.exam_fee * 3 %> every three months</p>
                </a>
                
                <!-- Half-Yearly Payment Button -->
                <a href="/half-yearly-payments" class="bg-white border-2 border-purple-600 hover:bg-purple-50 rounded-xl shadow-md p-8 flex flex-col items-center transition-all duration-300 cursor-pointer">
                    <svg class="w-16 h-16 text-purple-600 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                    </svg>
                    <h3 class="text-xl font-semibold text-gray-800 mb-2">Half-Yearly Payments</h3>
                    <p class="text-gray-600 text-center">Pay ₹<%= user.exam_fee * 6 %> every six months</p>
                </a>
            </div>
            
            <!-- Back to Home Button -->
            <div class="text-center mt-8">
                <button 
                    class="bg-purple-600 text-white px-6 py-3 rounded-lg cursor-pointer hover:bg-purple-700 transition-colors text-lg font-medium"
                    onclick="window.location.href = '/st-dashboard'">
                    Back to Home
                </button>
            </div>
        </div>
    </div>
</body>
</html>