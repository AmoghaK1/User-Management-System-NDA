<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/png" href="../images/favicon-2.0.3/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../images/favicon-2.0.3/favicon.svg" />
    <link rel="shortcut icon" href="../images/favicon-2.0.3/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon-2.0.3/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Nrutyashree" />
    <link rel="manifest" href="../images/favicon-2.0.3/site.webmanifest" />
    <title>Events | NDA</title>
    <link rel="stylesheet" href="../stylesheets/events.css">
    <link rel="stylesheet" href="../stylesheets/dashboard-back-button.css">
</head>
<body>
    <%- include('../partials/dashboard-back-button', { fallbackHref: '/student-dashboard' }) %>
    <div class="container">
        <div class="no-events-card">
            <div class="calendar-icon">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 80 80">
                    <rect x="5" y="15" width="70" height="60" rx="5" fill="#e0d1f0" stroke="#8e44ad" stroke-width="2"/>
                    <rect x="5" y="15" width="70" height="12" fill="#8e44ad"/>
                    <line x1="20" y1="5" x2="20" y2="25" stroke="#8e44ad" stroke-width="2"/>
                    <line x1="60" y1="5" x2="60" y2="25" stroke="#8e44ad" stroke-width="2"/>
                    
                    <!-- Calendar grid -->
                    <line x1="20" y1="40" x2="60" y2="40" stroke="#d5c5ea" stroke-width="1"/>
                    <line x1="20" y1="50" x2="60" y2="50" stroke="#d5c5ea" stroke-width="1"/>
                    <line x1="20" y1="60" x2="60" y2="60" stroke="#d5c5ea" stroke-width="1"/>
                    <line x1="30" y1="30" x2="30" y2="70" stroke="#d5c5ea" stroke-width="1"/>
                    <line x1="40" y1="30" x2="40" y2="70" stroke="#d5c5ea" stroke-width="1"/>
                    <line x1="50" y1="30" x2="50" y2="70" stroke="#d5c5ea" stroke-width="1"/>
                    
                    <!-- Highlight a cell -->
                    <rect x="50" y="50" width="10" height="10" fill="#8e44ad" opacity="0.5"/>
                </svg>
            </div>
            <h2 class="no-events-title">No Events Currently</h2>
            <p class="no-events-message">There are no upcoming events scheduled at this time. Check back later for updates.</p>
        </div>
    </div>
</body>
</html>