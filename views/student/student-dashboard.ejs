        <span class="fee-modal-close" id="closeFeeModal">&times;</span>
      </div>
      <div class="fee-modal-body">
        <p class="fee-announcement-text">
          Dear Students,<br>
          We would like to inform you about our updated monthly fee structure for the academic year. 
          Please find the details below:
        </p>
        <div class="fee-table-container">
          <table class="fee-table">
            <thead>
              <tr>
                <th>Exam Level</th>
                <th>Monthly Fee</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td><span class="exam-badge">Senior Batch</span></td>
                <td class="fee-amount">₹1,100</td>
              </tr>
              <tr>
                <td><span class="exam-badge">Prarambhik - 1st Exam</span></td>
                <td class="fee-amount">₹900</td>
              </tr>
              <tr>
                <td><span class="exam-badge">Praveshika Pratham - 2nd Exam</span></td>
                <td class="fee-amount">₹900</td>
              </tr>
              <tr>
                <td><span class="exam-badge">Praveshika Purna - 3rd Exam</span></td>
                <td class="fee-amount">₹1,000</td>
              </tr>
              <tr>
                <td><span class="exam-badge">Madhyama Pratham - 4th Exam</span></td>
                <td class="fee-amount">₹1,000</td>
              </tr>
              <tr>
                <td><span class="exam-badge">Madhyama Purna - 5th Exam</span></td>
                <td class="fee-amount">₹1,000</td>
              </tr>
              <tr>
                <td><span class="exam-badge">Visharad Pratham - 6th Exam</span></td>
                <td class="fee-amount">₹1,200</td>
              </tr>
              <tr>
                <td><span class="exam-badge">Visharad Purna - 7th Exam</span></td>
                <td class="fee-amount">₹1,200</td>
              </tr>
              <tr>
                <td><span class="exam-badge">Alankar Pratham - 8th Exam</span></td>
                <td class="fee-amount">₹1,500</td>
              </tr>
              <tr>
                <td><span class="exam-badge">Alankar Purna - 9th Exam</span></td>
                <td class="fee-amount">₹1,500</td>
              </tr>
              <tr>
                <td><span class="exam-badge">TMV-BA</span></td>
                <td class="fee-amount">₹1,200</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="fee-note">
          <i class="fa-solid fa-info-circle"></i> 
          For any queries regarding the fee structure, please contact the administration.
        </p>
      </div>
      <div class="fee-modal-footer">
        <button class="fee-modal-btn" id="acknowledgeBtn">I Understand</button>
      </div>
    </div>
  </div>

  <script>
    // Permanent Fee Structure Notification Modal
    (function() {
      const modal = document.getElementById('feeModal');
      const bell = document.getElementById('notification-bell');
      const badge = document.getElementById('notification-badge');
      const closeBtn = document.getElementById('closeFeeModal');
      const acknowledgeBtn = document.getElementById('acknowledgeBtn');
      
      // Check if user has seen the notification
      const hasSeenNotification = localStorage.getItem('feeNotificationSeen');
      
      // Show badge only if user hasn't seen it
      if (hasSeenNotification !== 'true') {
        badge.style.display = 'flex';
      }
      
      // Open modal when bell is clicked (always works)
      bell.addEventListener('click', function() {
        modal.style.display = 'flex';
        // Mark as seen and hide badge after first click
        if (hasSeenNotification !== 'true') {
          localStorage.setItem('feeNotificationSeen', 'true');
          badge.style.display = 'none';
        }
      });
      
      // Close modal functions
      function closeModal() {
        modal.style.display = 'none';
      }
      
      closeBtn.addEventListener('click', closeModal);
      acknowledgeBtn.addEventListener('click', closeModal);
      
      // Close when clicking outside modal
      window.addEventListener('click', function(event) {
        if (event.target === modal) {
          closeModal();
        }
      });
    })();
  </script>

  <script src="../javascripts/st-dashboard.js"></script>
