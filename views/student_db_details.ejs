                </div>

                <div class="fee-item unpaid">
                    <span class="fee-month">August 2025</span>
                    <button class="edit-btn">
                        <i class="fas fa-edit"></i>
                    </button>
                </div>

                <div class="fee-item unpaid">
                    <span class="fee-month">September 2025</span>
                    <button class="edit-btn">
