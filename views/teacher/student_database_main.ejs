<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Database - NDA</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../stylesheets/stdb_main.css">
    <link rel="icon" type="image/png" href="../images/favicon-2.0.3/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../images/favicon-2.0.3/favicon.svg" />
    <link rel="shortcut icon" href="../images/favicon-2.0.3/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon-2.0.3/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Nrutyashree" />
    <link rel="manifest" href="../images/favicon-2.0.3/site.webmanifest" />
</head>
<body>
    <div class="floating-particles">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>

    <div class="container">
        <% if (success && success.length > 0) { %>
          <div class="alert alert-success"><%= success[0] %></div>
        <% } %>        <div class="header">
            <h1>STUDENT DATABASE</h1>
        </div>

        <div class="search-filter-container">
            <div class="search-bar">
                <i class="fas fa-search search-icon"></i>
                <input type="text" id="searchInput" placeholder="Search students by name..." class="search-input">
                <button class="clear-search" id="clearSearch" style="display: none;">
                    <i class="fas fa-times"></i>
                </button>
            </div>
            <div class="filter-container">
                <select id="examLevelFilter" class="filter-select">
                    <option value="">All Exam Levels</option>
                    
                </select>
            </div>
        </div>

        <div class="student-grid" id="studentGrid">
            <% if (students && students.length > 0) { %>
                <% students.forEach(function(student) { %>
                    <a href="/student-db-details/<%= student._id %>">
                        <div class="student-card">
                            <div class="card-content">
                                <div class="student-info">                                    <h3 class="student-name">
                                        <%= student.name %>
                                        <span class="exam-level">
                                            <%= student.exam_level %>
                                        </span>
                                    </h3>
                                    <form method="POST" action="/students/<%= student._id %>?_method=DELETE" style="display:inline;">
                                        <button class="delete-btn" title="Delete Student" type="submit" onclick="return confirm('Are you sure you want to delete this student?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-user-slash"></i>
                    <h3>No students found.</h3>
                </div>
            <% } %>        </div>
    </div>

    <script src="../javascripts/stdb_main.js"></script>
</body>
</html>