<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student ID Card | NDA</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="../stylesheets/st-profile.css">
    <link rel="icon" type="image/png" href="../images/favicon-2.0.3/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../images/favicon-2.0.3/favicon.svg" />
    <link rel="shortcut icon" href="../images/favicon-2.0.3/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon-2.0.3/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Nrutyashree" />
    <link rel="manifest" href="../images/favicon-2.0.3/site.webmanifest" />
    <!-- Add FontAwesome if not already present -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />
</head>
<body class="min-h-screen bg-gradient-to-br from-gray-100 to-gray-200 p-4 md:p-8 flex items-center justify-center" data-is-verified="<%= user.is_verified ? 'true' : 'false' %>">
    <script>
        window.__PROFILE_CONTEXT__ = {
            isVerified: <%= user.is_verified ? 'true' : 'false' %>,
            verificationUrl: '/verification'
        };
    </script>
    <script src="../javascripts/st-profile.js"></script>
    <div class="w-full max-w-6xl bg-white rounded-2xl shadow-2xl overflow-hidden animate-fade-in">
        <!-- Original content remains the same until the modal -->
        <div class="flex flex-col md:flex-row">
            <!-- Left Section -->
            <div class="gradient-bg p-8 md:w-1/3 relative">
                <button class="absolute top-4 right-4 bg-white/90 hover:bg-white w-10 h-10 rounded-full flex items-center justify-center transition-all duration-300 hover:scale-105" onclick="openEditModal()">
                    ✏️
                </button>
            
                <div class="flex flex-col items-center justify-center h-full space-y-6">
                    <div class="profile-container w-32 h-32 md:w-40 md:h-40 relative">
                        <!-- Profile Picture -->
                        <div class="w-full h-full rounded-full overflow-hidden border-4 border-white/90 shadow-lg relative">
                            <img id="profileImage" src="<%= user.profilePicture %>" alt="Profile Picture" 
                                 class="w-full h-full object-cover transition-transform duration-300">
                            
                            <!-- Spinner (Initially Hidden) -->
                            <div id="loadingSpinner" class="absolute inset-0 bg-white/70 flex items-center justify-center hidden">
                                <div class="w-8 h-8 border-4 border-gray-300 border-t-blue-500 rounded-full animate-spin"></div>
                            </div>
                        </div>
            
                        <!-- Camera Icon -->
                        <label for="profilePicture" class="camera-icon">
                            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" width="18" height="18" stroke="currentColor" stroke-width="2" fill="none">
                                <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"></path>
                                <circle cx="12" cy="13" r="4"></circle>
                            </svg>
                        </label>
            
                        <!-- File Input -->
                        <input type="file" id="profilePicture" name="profilePicture" accept="image/png,image/jpeg,image/jpg">
                    </div>
            
                    <div class="text-center text-white space-y-2">
                        <h2 class="text-2xl md:text-3xl font-bold" data-field="name"><%= user.name %></h2>
                        <p class="text-white/90"><%= user.exam_level %></p>
                        <div class="verification-chip <%= user.is_verified ? 'chip-verified' : 'chip-pending' %>">
                            <i class="fa-solid <%= user.is_verified ? 'fa-circle-check' : 'fa-circle-xmark' %>"></i>
                            <span><%= user.is_verified ? 'Verified via Google' : 'Verification pending' %></span>
                        </div>
                    </div>
                </div>
            </div>
        
            <!-- Right Section -->
            <div class="p-6 md:p-8 lg:p-10 md:w-2/3">
                <!-- Original sections remain the same -->
                <div class="space-y-8">
                    <section>
                        <h3 class="text-purple-600 text-xl font-semibold mb-4">Personal Information</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="info-item bg-gray-50 p-4 rounded-xl">
                                <span class="block text-gray-500 text-sm">DOB</span>
                                <span class="text-gray-800" data-field="birthdate"><%= user.birthdate %></span>
                            </div>
                            <div class="info-item bg-gray-50 p-4 rounded-xl">
                                <span class="block text-gray-500 text-sm">Age</span>
                                <span class="text-gray-800"><%= user.age %></span>
                            </div>
                            <div class="info-item bg-gray-50 p-4 rounded-xl">
                                <span class="block text-gray-500 text-sm">Student Email</span>
                                <span class="text-gray-800" data-field="email"><%= user.email %></span>
                            </div>
                            <div class="info-item bg-gray-50 p-4 rounded-xl">
                                <span class="block text-gray-500 text-sm">Joined Date</span>
                               <span class="text-gray-800"><%= new Date(user.createdAt).toLocaleDateString('en-GB') %></span>
                            </div>
                        </div>
                    </section>

                    <section>
                        <h3 class="text-purple-600 text-xl font-semibold mb-4">Contact Information</h3>
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                            <div class="info-item bg-gray-50 p-4 rounded-xl">
                                <span class="block text-gray-500 text-sm">Parent / Student Phone</span>
                                <span class="text-gray-800" data-field="student_ph_no"><%= user.student_ph_no %></span>
                            </div>
                            
                        </div>
                    </section>

                    <% if (!user.is_verified) { %>
                    <div class="profile-verification-banner" role="alert">
                        <div class="banner-content">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <div>
                                <p class="banner-title">One more step!</p>
                                <p class="banner-copy">Verify with Google to manage security-sensitive settings like password changes.</p>
                            </div>
                        </div>
                        <a href="/verification" class="banner-link">Verify now</a>
                    </div>
                    <% } %>
                    
                    <div class="bg-gray-50 p-6 rounded-xl text-center space-y-2">
                        <img src="../images/barcode.gif" alt="Barcode" class="mx-auto transition-transform duration-300 hover:scale-105">
                        <div class="text-gray-500 text-sm">Valid until: 31/12/2026</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Edit Modal with Profile and Password Forms -->
    <div class="fixed inset-0 bg-black bg-opacity-50 flex items-center justify-center hidden" id="editModal">
        <div class="bg-white rounded-lg p-6 w-full max-w-md">
            <div class="flex justify-between items-center mb-4">
                <h2 class="text-xl font-bold">Edit Profile</h2>
                <div class="space-x-2">
                    <button type="button" class="text-purple-600 hover:text-purple-800" onclick="showProfileForm()">Profile</button>
                    <button type="button" class="text-purple-600 hover:text-purple-800" onclick="showPasswordForm()" data-password-tab="true">Password</button>
                </div>
            </div>

            <div id="passwordLockNotice" class="verification-hint-modal <%= user.is_verified ? 'hidden' : '' %>">
                <div class="hint-icon">
                    <i class="fa-solid fa-lock"></i>
                </div>
                <div>
                    <h4>Verification required</h4>
                    <p>Complete Google verification to unlock password changes.</p>
                </div>
                <a href="/verification" class="hint-link">Verify now</a>
            </div>

            <!-- Profile Edit Form -->
            <form id="editProfileForm" class="space-y-4">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Name</label>
                    <input type="text" name="name" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Email</label>
                    <input type="email" name="email" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Parent / Student Phone</label>
                    <input type="tel" name="student_ph_no" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm">
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" class="px-4 py-2 bg-gray-200 rounded-md" onclick="closeEditModal()">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-purple-600 text-white rounded-md">Save Changes</button>
                </div>
            </form>

            <!-- Password Change Form -->
            <form id="changePasswordForm" class="space-y-4 hidden" data-requires-verification="true">
                <div>
                    <label class="block text-sm font-medium text-gray-700">Current Password</label>
                    <div class="input-wrapper relative">
                        <input type="password" name="currentPassword" id="currentPassword" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm pr-12" required>
                        <i class="fa-solid fa-eye absolute right-4 top-1/2 transform -translate-y-1/2 cursor-pointer text-gray-500" id="toggleCurrentPassword" style="font-size: 1.1rem;"></i>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">New Password</label>
                    <div class="input-wrapper relative">
                        <input type="password" name="newPassword" id="newPassword" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm pr-12" required>
                        <i class="fa-solid fa-eye absolute right-4 top-1/2 transform -translate-y-1/2 cursor-pointer text-gray-500" id="toggleNewPassword" style="font-size: 1.1rem;"></i>
                    </div>
                </div>
                <div>
                    <label class="block text-sm font-medium text-gray-700">Confirm New Password</label>
                    <div class="input-wrapper relative">
                        <input type="password" name="confirmPassword" id="confirmPassword" class="mt-1 block w-full rounded-md border-gray-300 shadow-sm pr-12" required>
                        <i class="fa-solid fa-eye absolute right-4 top-1/2 transform -translate-y-1/2 cursor-pointer text-gray-500" id="toggleConfirmPassword" style="font-size: 1.1rem;"></i>
                    </div>
                </div>
                <div class="flex justify-end space-x-3">
                    <button type="button" class="px-4 py-2 bg-gray-200 rounded-md" onclick="closeEditModal()">Cancel</button>
                    <button type="submit" class="px-4 py-2 bg-purple-600 text-white rounded-md">Change Password</button>
                </div>
            </form>
        </div>
    </div>

    <script>
        // Password validation function (optional: add your own rules)
        function isPasswordValid(password) {
            // At least 8 chars, one uppercase, one lowercase, one digit
            return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/.test(password);
        }

        // Password eye toggle logic for all password fields
        function setupPasswordToggle(inputId, toggleId) {
            const input = document.getElementById(inputId);
            const toggle = document.getElementById(toggleId);
            if (input && toggle) {
                toggle.addEventListener('click', () => {
                    const type = input.type === "password" ? "text" : "password";
                    input.type = type;
                    toggle.classList.toggle("fa-eye");
                    toggle.classList.toggle("fa-eye-slash");
                });
            }
        }
        setupPasswordToggle("currentPassword", "toggleCurrentPassword");
        setupPasswordToggle("newPassword", "toggleNewPassword");
        setupPasswordToggle("confirmPassword", "toggleConfirmPassword");

        // Password change form validation
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('changePasswordForm');
            if (form) {
                form.addEventListener('submit', function(e) {
                    const currentPassword = document.getElementById('currentPassword').value;
                    const newPassword = document.getElementById('newPassword').value;
                    const confirmPassword = document.getElementById('confirmPassword').value;
                    const errorDiv = document.getElementById('passwordClientError');
                    errorDiv.style.display = "none";
                    errorDiv.textContent = "";

                    if (!isPasswordValid(newPassword)) {
                        e.preventDefault();
                        errorDiv.textContent = "New password must be at least 8 characters long and include an uppercase letter, a lowercase letter, and a digit.";
                        errorDiv.style.display = "block";
                        errorDiv.scrollIntoView({behavior: "smooth", block: "center"});
                    } else if (newPassword !== confirmPassword) {
                        e.preventDefault();
                        errorDiv.textContent = "New password and confirm password do not match.";
                        errorDiv.style.display = "block";
                        errorDiv.scrollIntoView({behavior: "smooth", block: "center"});
                    } else if (currentPassword === newPassword) {
                        e.preventDefault();
                        errorDiv.textContent = "New password cannot be the same as the current password.";
                        errorDiv.style.display = "block";
                        errorDiv.scrollIntoView({behavior: "smooth", block: "center"});
                    }
                });
            }
        });
    </script>
</body>
</html>