<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password | NDA</title>
    <link rel="stylesheet" href="../stylesheets/login.css">
    <link rel="icon" type="image/png" href="../images/favicon-2.0.3/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../images/favicon-2.0.3/favicon.svg" />
    <link rel="shortcut icon" href="../images/favicon-2.0.3/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon-2.0.3/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Nrutyashree" />
    <link rel="manifest" href="../images/favicon-2.0.3/site.webmanifest" />
</head>
<body>
    <div class="login-container">
        <div class="form-section">
            <div class="login-form">
                <% if (error) { %>
                    <div class="error-message">
                        <span><%= error %></span>
                    </div>
                <% } %>
                <% if (success) { %>
                    <div class="success-message">
                        <span><%= success %></span>
                    </div>
                <% } %>
                <h2>Forgot Password</h2>
                <% if (!otpSent) { %>
                    <p class="subtitle">Enter your registered parent / student phone number to receive an OTP</p>
                    <form method="post" action="/forgot-password">
                        <input type="hidden" name="intent" value="request">
                        <div class="form-group">
                            <label for="phoneNumber">Parent / Student Phone Number</label>
                            <input type="tel" id="phoneNumber" name="phoneNumber" placeholder="e.g. +91XXXXXXXXXX" value="<%= phoneValue || '' %>" required>
                        </div>
                        <button type="submit">Send OTP</button>
                        <div class="signup-prompt">
                            Remember your password? <a href="/login">Login</a>
                        </div>
                    </form>
                <% } else { %>
                    <p class="subtitle">OTP sent to <strong><%= maskedPhone %></strong></p>
                    <form method="post" action="/forgot-password">
                        <input type="hidden" name="intent" value="verify">
                        <div class="form-group">
                            <label>Parent / Student Phone Number</label>
                            <input type="tel" value="<%= phoneValue %>" readonly>
                        </div>
                        <div class="form-group">
                            <label for="otpCode">One-Time Password</label>
                            <input type="text" id="otpCode" name="otpCode" inputmode="numeric" pattern="[0-9]{4,8}" maxlength="8" required>
                        </div>
                        <div class="form-group">
                            <label for="password">New Password</label>
                            <input type="password" id="password" name="password" required>
                        </div>
                        <div class="form-group">
                            <label for="confirmPassword">Confirm New Password</label>
                            <input type="password" id="confirmPassword" name="confirmPassword" required>
                        </div>
                        <button type="submit">Reset Password</button>
                    </form>
                    <form method="post" action="/forgot-password" style="margin-top: 1rem; text-align: center;">
                        <input type="hidden" name="intent" value="resend">
                        <button type="submit" class="link-button">Resend OTP</button>
                    </form>
                    <div class="signup-prompt" style="margin-top: 1rem;">
                        Already reset your password? <a href="/login">Login</a>
                    </div>
                <% } %>
            </div>
        </div>
    </div>
</body>
</html>