  <!-- Fee Structure Notification Modal -->
  <div id="feeModal" class="fee-modal" style="display: none;">
    <div class="fee-modal-content">
      <div class="fee-modal-header">
        <h2><i class="fa-solid fa-bullhorn"></i> Updated Fee Structure Announcement</h2>
        <span class="fee-modal-close" id="closeFeeModal">&times;</span>
      </div>
      <div class="fee-modal-body">
        <p class="fee-announcement-text">
          Dear Students,<br>
          We would like to inform you about our updated monthly fee structure for the academic year. 
          Please find the details below:
        </p>
        <div class="fee-table-container">
          <table class="fee-table">
            <thead>
              <tr>
                <th>Exam Level</th>
                <th>Monthly Fee</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Senior Batch</td>
                <td class="fee-amount">₹1,100</td>
              </tr>
              <tr>
                <td>Prarambhik - 1st Exam</td>
                <td class="fee-amount">₹900</td>
              </tr>
              <tr>
                <td>Praveshika Pratham - 2nd Exam</td>
                <td class="fee-amount">₹900</td>
              </tr>
              <tr>
                <td>Praveshika Purna - 3rd Exam</td>
                <td class="fee-amount">₹1,000</td>
              </tr>
              <tr>
                <td>Madhyama Pratham - 4th Exam</td>
                <td class="fee-amount">₹1,000</td>
              </tr>
              <tr>
                <td>Madhyama Purna - 5th Exam</td>
                <td class="fee-amount">₹1,000</td>
              </tr>
              <tr>
                <td>Visharad Pratham - 6th Exam</td>
                <td class="fee-amount">₹1,200</td>
              </tr>
              <tr>
                <td>Visharad Purna - 7th Exam</td>
                <td class="fee-amount">₹1,200</td>
              </tr>
              <tr>
                <td>Alankar Pratham - 8th Exam</td>
                <td class="fee-amount">₹1,500</td>
              </tr>
              <tr>
                <td>Alankar Purna - 9th Exam</td>
                <td class="fee-amount">₹1,500</td>
              </tr>
              <tr>
                <td>TMV-BA</td>
                <td class="fee-amount">₹1,200</td>
              </tr>
            </tbody>
          </table>
        </div>
        <p class="fee-note">
          <i class="fa-solid fa-info-circle"></i> 
          For any queries regarding the fee structure, please contact the administration.
        </p>
      </div>
      <div class="fee-modal-footer">
        <button class="fee-modal-btn" id="acknowledgeBtn">I Understand</button>
      </div>
    </div>
  </div>

  <script>
    // Permanent Fee Structure Notification Modal
    (function() {
      const modal = document.getElementById('feeModal');
      const bell = document.getElementById('notification-bell');
      const badge = document.getElementById('notification-badge');
      const closeBtn = document.getElementById('closeFeeModal');
      const acknowledgeBtn = document.getElementById('acknowledgeBtn');
      const announcementTriggers = document.querySelectorAll('[data-open-fee-modal]');
      const userId = document.body.getAttribute('data-user-id') || 'global';
      const storageKey = 'feeNotificationSeen:' + userId;

      if (!modal || !bell || !badge || !closeBtn || !acknowledgeBtn) {
        return;
      }

      let hasSeenNotification = localStorage.getItem(storageKey) === 'true';

      if (!hasSeenNotification) {
        badge.style.display = 'flex';
      } else {
        badge.style.display = 'none';
      }

      function openModal() {
        modal.style.display = 'flex';
      }

      function markNotificationAsSeen() {
        if (hasSeenNotification) return;

        localStorage.setItem(storageKey, 'true');
        hasSeenNotification = true;
        badge.style.display = 'none';
      }

      bell.addEventListener('click', openModal);
      badge.addEventListener('click', openModal);
      announcementTriggers.forEach(function(trigger) {
        trigger.addEventListener('click', function(event) {
          event.preventDefault();
          openModal();
        });
      });

      function closeModal() {
        modal.style.display = 'none';
        markNotificationAsSeen();
      }

      closeBtn.addEventListener('click', closeModal);
      acknowledgeBtn.addEventListener('click', closeModal);

      window.addEventListener('click', function(event) {
        if (event.target === modal) {
          closeModal();
        }
      });
    })();
  </script>

  <script src="../javascripts/st-dashboard.js"></script>
</body>
