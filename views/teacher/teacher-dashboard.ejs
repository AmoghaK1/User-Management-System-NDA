  <!-- Fee Collection Modal -->
  <div id="feeCollectionModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2 style="color: white;">Monthly Fee Collection Report</h2>
            <span class="close-modal">&times;</span>
        </div>
        <div class="modal-body">
            <div id="feeCollectionLoading" class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>Loading fee collection data...</p>
            </div>
            
            <!-- Summary Cards -->
            <div class="fee-summary-cards" style="display: none;">
                <div class="summary-card total">
                    <div class="summary-icon">
                        <i class="fa-solid fa-rupee-sign"></i>
                    </div>
                    <div class="summary-content">
                        <h3 id="totalCollection">₹0</h3>
                        <p>Total Collection</p>
                    </div>
                </div>
                <div class="summary-card current-month">
                    <div class="summary-icon">
                        <i class="fa-solid fa-calendar-month"></i>
                    </div>
                    <div class="summary-content">
                        <h3 id="currentMonthCollection">₹0</h3>
                        <p>This Month</p>
                    </div>
                </div>
                <div class="summary-card pending">
                    <div class="summary-icon">
                        <i class="fa-solid fa-clock"></i>
                    </div>
                    <div class="summary-content">
                        <h3 id="pendingCollection">₹0</h3>
                        <p>Pending</p>
                    </div>
                </div>
            </div>

            <!-- Chart Container -->
            <div class="chart-container" style="display: none;">
                <canvas id="feeCollectionChart"></canvas>
            </div>
            
            <div class="table-responsive" style="display: none;">
                <table id="feeCollectionTable" class="table table-striped" style="width:100%">
                    <!-- DataTable will populate this -->
                </table>
            </div>
        </div>
    </div>
  </div>

  
  <!-- Include jQuery first -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
