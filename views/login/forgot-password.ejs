<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot Password</title>
    <link rel="stylesheet" href="../stylesheets/login.css">
    <link rel="icon" type="image/png" href="../images/favicon-2.0.3/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="../images/favicon-2.0.3/favicon.svg" />
    <link rel="shortcut icon" href="../images/favicon-2.0.3/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="../images/favicon-2.0.3/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Nrutyashree" />
    <link rel="manifest" href="../images/favicon-2.0.3/site.webmanifest" />
</head>
<body>
    <div class="login-container">
        <div class="form-section">
            <div class="login-form">
                <% if (error) { %>
                    <div class="error-message">
                        <span><%= error %></span>
                    </div>
                <% } %>
                <% if (success) { %>
                    <div class="success-message">
                        <span><%= success %></span>
                    </div>
                <% } %>
                <h2>Forgot Password</h2>
                <p class="subtitle">Enter your email to reset your password</p>
                <form method="post" action="/forgot-password">
                    <div class="form-group">
                        <label for="email">Email Address</label>
                        <input type="email" id="email" name="email" required>
                    </div>
                    <button type="submit">Send Reset Link</button>
                    <div class="signup-prompt">
                        Remember your password? <a href="/login">Login</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</body>
</html>