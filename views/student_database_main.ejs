<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Database - NDA</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 2rem;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            overflow: hidden;
            animation: fadeInUp 0.8s ease-out;
        }

        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(30px);
            }
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .header {
            background: linear-gradient(135deg, #6c5ce7 0%, #8e44ad 100%);
            padding: 2rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .header h1 {
            color: white;
            font-size: 2.5rem;
            font-weight: 700;
            text-shadow: 0 2px 10px rgba(0, 0, 0, 0.2);
            position: relative;
            z-index: 2;
            letter-spacing: 1px;
        }        .student-grid {
            padding: 2rem;
            display: grid;
            gap: 1.5rem;
            grid-template-columns: repeat(2, 1fr);
        }        .student-card {
            background: white;
            border-radius: 15px;
            padding: 1.5rem;
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
            position: relative;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
            cursor: pointer;
        }

        .student-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, #6c5ce7 0%, #8e44ad 100%);
            transform: scaleX(0);
            transition: transform 0.3s ease;
        }

        .student-card:hover::before {
            transform: scaleX(1);
        }

        .student-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(108, 92, 231, 0.2);
            border-color: #6c5ce7;
        }

        .student-card:hover .card-content {
            transform: scale(1.02);
        }

        .card-content {
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: transform 0.3s ease;
        }

        .student-info {
            flex: 1;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .student-name {
            font-size: 1.2rem;
            font-weight: 600;
            color: #2c3e50;
            margin: 0;
            transition: color 0.3s ease;
        }

        .student-card:hover .student-name {
            color: #6c5ce7;
        }        .exam-level {
            background: linear-gradient(135deg, #6c5ce7 0%, #8e44ad 100%);
            color: white;
            padding: 0.4rem 1rem;
            border-radius: 25px;
            font-size: 0.75rem;
            font-weight: 600;
            text-align: center;
            box-shadow: 0 4px 15px rgba(108, 92, 231, 0.3);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .exam-level::before {
            content: '';
            position: absolute;
            top: 0;
            left: -100%;
            width: 100%;
            height: 100%;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
            transition: left 0.5s ease;
        }

        .student-card:hover .exam-level::before {
            left: 100%;
        }

        .delete-btn {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
            color: white;
            border: none;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 15px rgba(255, 107, 107, 0.3);
            position: relative;
            overflow: hidden;
        }

        .delete-btn::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 0;
            height: 0;
            background: rgba(255, 255, 255, 0.2);
            border-radius: 50%;
            transform: translate(-50%, -50%);
            transition: all 0.4s ease;
        }

        .delete-btn:hover::before {
            width: 100%;
            height: 100%;
        }

        .delete-btn:hover {
            transform: scale(1.1) rotate(10deg);
            box-shadow: 0 8px 25px rgba(255, 107, 107, 0.4);
        }

        .delete-btn i {
            font-size: 1.1rem;
            z-index: 2;
            position: relative;
        }

        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            color: #7f8c8d;
        }

        .empty-state i {
            font-size: 4rem;
            margin-bottom: 1rem;
            color: #bdc3c7;
        }

        .empty-state h3 {
            margin-bottom: 0.5rem;
            font-size: 1.5rem;
        }

        .floating-particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .particle {
            position: absolute;
            background: #6c5ce7;
            border-radius: 50%;
            opacity: 0.1;
            animation: float 15s infinite ease-in-out;
        }

        .particle:nth-child(1) {
            width: 10px;
            height: 10px;
            left: 10%;
            animation-delay: 0s;
        }

        .particle:nth-child(2) {
            width: 20px;
            height: 20px;
            left: 80%;
            animation-delay: 5s;
        }

        .particle:nth-child(3) {
            width: 15px;
            height: 15px;
            left: 60%;
            animation-delay: 10s;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(100vh) rotate(0deg);
                opacity: 0;
            }
            10%, 90% {
                opacity: 0.1;
            }
            50% {
                transform: translateY(-100px) rotate(180deg);
                opacity: 0.3;
            }
        }        @media (max-width: 768px) {
            body {
                padding: 1rem;
            }

            .header h1 {
                font-size: 2rem;
            }

            .student-grid {
                grid-template-columns: 1fr;
                padding: 1rem;
            }

            .student-card {
                padding: 1rem;
            }

            .card-content {
                display: block;
            }

            .student-info {
                display: block;
            }

            .student-info .student-name {
                display: flex;
                justify-content: space-between;
                align-items: center;
                margin-bottom: 0.5rem;
            }

            .student-info .exam-level {
                background: none;
                color: #6c5ce7;
                padding: 0;
                border-radius: 0;
                font-size: 0.8rem;
                font-weight: 500;
                text-align: left;
                box-shadow: none;
                margin: 0;
            }

            .student-info .exam-level::before {
                display: none;
            }

            .delete-btn {
                position: absolute;
                top: 1rem;
                right: 1rem;
                width: 35px;
                height: 35px;
            }
        }

        .loading-skeleton {
            background: linear-gradient(90deg, #f0f0f0 25%, #e0e0e0 50%, #f0f0f0 75%);
            background-size: 200% 100%;
            animation: loading 1.5s infinite;
        }

        @keyframes loading {
            0% {
                background-position: 200% 0;
            }
            100% {
                background-position: -200% 0;
            }
        }
        .alert {
    padding: 1rem 1.5rem;
    margin: 1.5rem 0 1rem 0;
    border-radius: 8px;
    font-size: 1.1rem;
    font-weight: 500;
    box-shadow: 0 2px 8px rgba(0,0,0,0.07);
}
.alert-success {
    background: #e6ffed;
    color: #207544;
    border: 1px solid #b7f5c6;
}
    </style>
</head>
<body>
    <div class="floating-particles">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>

    <div class="container">
        <% if (success && success.length > 0) { %>
          <div class="alert alert-success"><%= success[0] %></div>
        <% } %>
        <div class="header">
            <h1>STUDENT DATABASE</h1>
        </div>

        <div class="student-grid">
            <% if (students && students.length > 0) { %>
                <% students.forEach(function(student) { %>
                    <a href="/student-db-details/<%= student._id %>">
                        <div class="student-card">
                            <div class="card-content">
                                <div class="student-info">
                                    <h3 class="student-name">
                                        <%= student.name %>
                                        <span class="exam-level" style="display:inline-block;margin-left:1rem;background:linear-gradient(135deg,#6c5ce7 0%,#8e44ad 100%);color:white;padding:0.3rem 1rem;border-radius:25px;font-size:0.9rem;font-weight:600;vertical-align:middle;">
                                            <%= student.exam_level %>
                                        </span>
                                    </h3>
                                    <form method="POST" action="/students/<%= student._id %>?_method=DELETE" style="display:inline;">
                                        <button class="delete-btn" title="Delete Student" type="submit" onclick="return confirm('Are you sure you want to delete this student?');">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </a>
                <% }); %>
            <% } else { %>
                <div class="empty-state">
                    <i class="fas fa-user-slash"></i>
                    <h3>No students found.</h3>
                </div>
            <% } %>
        </div>
    </div>
</body>
</html>