<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Details - NDA</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            padding: 1rem;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
            display: grid;
            gap: 2rem;
            grid-template-columns: 1fr;
        }        .student-profile {
            background: linear-gradient(135deg, #8e44ad 0%, #6c5ce7 100%);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            position: relative;
            overflow: hidden;
            animation: fadeInLeft 0.8s ease-out;
        }

        .student-profile::before {
            content: '';
            position: absolute;
            top: -50%;
            right: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            animation: rotate 25s linear infinite;
        }

        @keyframes rotate {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        @keyframes fadeInLeft {
            from {
                opacity: 0;
                transform: translateX(-30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .profile-header {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            margin-bottom: 2rem;
            position: relative;
            z-index: 2;
        }        .profile-avatar {
            width: 80px;
            height: 80px;
            background: linear-gradient(135deg, #4a148c 0%, #7b1fa2 100%);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 2rem;
            color: white;
            font-weight: bold;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            transition: transform 0.3s ease;
        }

        .profile-avatar:hover {
            transform: scale(1.1) rotate(10deg);
        }        .profile-name {
            font-size: 2rem;
            font-weight: 700;
            color: white;
            margin-bottom: 0.5rem;
        }        .search-icon {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            background: rgba(255, 255, 255, 0.2);
            color: white;
            width: 45px;
            height: 45px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .search-icon:hover {
            background: rgba(255, 255, 255, 0.3);
            transform: scale(1.1);
        }

        .profile-details {
            display: grid;
            gap: 0.8rem;
            position: relative;
            z-index: 2;
        }        .detail-item {
            display: flex;
            align-items: center;
            font-size: 1.1rem;
            color: white;
            font-weight: 500;
        }

        .detail-label {
            font-weight: 600;
            min-width: 80px;
        }

        .fee-section {
            background: rgba(255, 255, 255, 0.95);
            border-radius: 20px;
            padding: 2rem;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.1);
            backdrop-filter: blur(10px);
            animation: fadeInRight 0.8s ease-out;
        }

        @keyframes fadeInRight {
            from {
                opacity: 0;
                transform: translateX(30px);
            }
            to {
                opacity: 1;
                transform: translateX(0);
            }
        }

        .fee-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 1.5rem;
        }

        .fee-title {
            font-size: 1.8rem;
            font-weight: 700;
            color: #2c3e50;
        }

        .fee-amount {
            font-size: 1.2rem;
            color: #666;
            margin-bottom: 1.5rem;
        }

        .fee-toggle {
            display: flex;
            background: #e9ecef;
            border-radius: 25px;
            padding: 4px;
            gap: 4px;
        }

        .toggle-btn {
            padding: 0.5rem 1rem;
            border: none;
            border-radius: 20px;
            font-size: 0.9rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            background: transparent;
            color: #666;
        }

        .toggle-btn.active {
            background: linear-gradient(135deg, #6c5ce7 0%, #8e44ad 100%);
            color: white;
            box-shadow: 0 4px 15px rgba(108, 92, 231, 0.3);
        }

        .fee-list {
            display: grid;
            gap: 1rem;
        }

        .fee-item {
            background: white;
            border-radius: 15px;
            padding: 1.2rem;
            display: flex;
            justify-content: space-between;
            align-items: center;
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.05);
            transition: all 0.3s ease;
            position: relative;
            overflow: hidden;
        }

        .fee-item::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            transition: transform 0.3s ease;
        }

        .fee-item.paid::before {
            background: linear-gradient(90deg, #00d4aa 0%, #00b894 100%);
            transform: scaleX(1);
        }

        .fee-item.unpaid::before {
            background: linear-gradient(90deg, #ff6b6b 0%, #ee5a52 100%);
            transform: scaleX(1);
        }

        .fee-item:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        }

        .fee-month {
            font-size: 1.1rem;
            font-weight: 600;
            color: #2c3e50;
        }

        .fee-item.paid {
            background: linear-gradient(135deg, #00d4aa 0%, #00b894 100%);
            color: white;
        }

        .fee-item.paid .fee-month {
            color: white;
        }

        .fee-item.unpaid {
            background: linear-gradient(135deg, #ff6b6b 0%, #ee5a52 100%);
            color: white;
        }

        .fee-item.unpaid .fee-month {
            color: white;
        }

        .edit-btn {
            background: rgba(255, 255, 255, 0.3);
            color: white;
            border: none;
            width: 35px;
            height: 35px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(10px);
        }

        .edit-btn:hover {
            background: rgba(255, 255, 255, 0.4);
            transform: scale(1.1) rotate(15deg);
        }        /* Desktop Layout */
        @media (min-width: 769px) {
            .container {
                grid-template-columns: 400px 1fr;
                gap: 3rem;
                padding: 2rem;
            }

            .student-profile {
                padding: 2.5rem;
                height: fit-content;
            }

            .profile-name {
                font-size: 2.2rem;
            }

            .fee-section {
                padding: 3rem;
                background: transparent;
                box-shadow: none;
                backdrop-filter: none;
            }

            .fee-list {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 1.5rem;
            }
        }        /* Mobile Layout */
        @media (max-width: 768px) {
            body {
                padding: 0.5rem;
            }

            .container {
                gap: 1.5rem;
            }

            .student-profile {
                padding: 1.5rem;
            }

            .profile-header {
                flex-direction: row;
                text-align: left;
                gap: 1rem;
                align-items: center;
            }

            .profile-name {
                font-size: 1.8rem;
                margin-bottom: 0;
            }

            .profile-avatar {
                width: 60px;
                height: 60px;
                font-size: 1.5rem;
            }

            .search-icon {
                top: 1rem;
                right: 1rem;
                width: 40px;
                height: 40px;
            }

            .fee-section {
                padding: 1.5rem;
                background: transparent;
                box-shadow: none;
                backdrop-filter: none;
            }

            .fee-header {
                flex-direction: column;
                gap: 1rem;
                align-items: flex-start;
            }

            .fee-title {
                font-size: 1.5rem;
            }

            .fee-toggle {
                align-self: stretch;
            }

            .toggle-btn {
                flex: 1;
                text-align: center;
            }

            .fee-item {
                padding: 1rem;
            }

            .detail-item {
                font-size: 1rem;
            }

            /* Hide DOB on mobile */
            .detail-item:last-child {
                display: none;
            }
        }

        .floating-particles {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
            z-index: -1;
        }

        .particle {
            position: absolute;
            background: #6c5ce7;
            border-radius: 50%;
            opacity: 0.1;
            animation: float 20s infinite ease-in-out;
        }

        .particle:nth-child(1) {
            width: 8px;
            height: 8px;
            left: 20%;
            animation-delay: 0s;
        }

        .particle:nth-child(2) {
            width: 12px;
            height: 12px;
            left: 70%;
            animation-delay: 7s;
        }

        .particle:nth-child(3) {
            width: 10px;
            height: 10px;
            left: 50%;
            animation-delay: 14s;
        }

        @keyframes float {
            0%, 100% {
                transform: translateY(100vh) rotate(0deg);
                opacity: 0;
            }
            10%, 90% {
                opacity: 0.1;
            }
            50% {
                transform: translateY(-50px) rotate(180deg);
                opacity: 0.2;
            }
        }
    </style>
</head>
<body>
    <div class="floating-particles">
        <div class="particle"></div>
        <div class="particle"></div>
        <div class="particle"></div>
    </div>

    <div class="container">
        <!-- Student Profile Section -->
