<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Teacher Dashboard | Nrutyashree Dance Academy</title>
  
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" integrity="sha512-SnH5WK+bZxgPHs44uWIX+LLJAJ9/2PkPKZ5QiAj6Ta86w+fsb2TkcmfRyVX3pBnMFcV7oQPJkl9QevSCWr3W6A==" crossorigin="anonymous" referrerpolicy="no-referrer" />
  <link rel="icon" type="favicon" href="../images/nda-favicon-v2.png">
  <link rel="stylesheet" href="../stylesheets/trdashboard.css">
  <!-- Add Fee Collection CSS -->
  <link rel="stylesheet" href="../stylesheets/feeCollection.css">
  <!-- Add DataTables CSS -->
  <link rel="stylesheet" href="https://cdn.datatables.net/1.11.5/css/jquery.dataTables.min.css">
  <link rel="stylesheet" href="https://cdn.datatables.net/buttons/2.2.2/css/buttons.dataTables.min.css">
</head>
<body>
  <!-- Navbar -->
  <div class="my-navbar">
    <div class="user-profile">
      <a href="/teacher-profile"><img id="user-pfp" src="/api/placeholder/40/40" alt="user-pfp"></a>
      <div class="user-name">Rajshree Khare</div>
    </div>
    <div class="navbar-center-section">
      <div>Teacher Dashboard</div>
    </div>
    <div class="navbar-icons">
      <i class="fa-solid fa-bell nav-icon"></i>
      <i class="fa-solid fa-phone nav-icon"></i>
      <button id="logout-btn"><a href="logout">Logout</a></button>
    </div>
  </div>
  <div class="navbar-mobile">
    <div class="exam-name">Teacher Dashboard</div>
  </div>
  
  <!-- Thought of the Day -->
  <div class="thought-section">
    <div class="thought-box">
      <p>Dance is the hidden language of the soul. The body says what words cannot.</p>
      <span class="author">Martha Graham</span>
    </div>
  </div>
  
  <!-- Dashboard Container -->
  <div class="dashboard-container">
    <!-- Stats Section -->
    <div class="stats-section">
      <!-- Fees Collection Card -->
      <div class="stat-card fees">
        <div class="stat-header">
          <div class="stat-title">Fees Collection</div>
          <div class="stat-icon fees">
            <i class="fa-solid fa-rupee-sign"></i>
          </div>
        </div>
        <div class="stat-value">₹85,200</div>
        <div class="stat-trend">
          <i class="fa-solid fa-arrow-up trending-up"></i>
          <span class="trend-value">+8% this month</span>
        </div>
        <div class="stat-progress">
          <div class="progress-bar">
            <div class="progress-fill fees"></div>
          </div>
          <div class="progress-label">
            <span>Target: ₹100,000</span>
            <span>85%</span>
          </div>
        </div>
      </div>
    </div>
  
    <!-- Quick Access Section -->
    <div class="quick-access-section">
      <div class="quick-card">
        <div class="quick-icon">
          <i class="fa-solid fa-user-plus"></i>
        </div>
        <div class="quick-title">Add Student</div>
      </div>
      
      <div class="quick-card">
        <div class="quick-icon">
          <i class="fa-solid fa-clipboard-list"></i>
        </div>
        <div class="quick-title">Take Attendance</div>
      </div>
      
      <div class="quick-card">
        <div class="quick-icon">
          <i class="fa-solid fa-rupee-sign"></i>
        </div>
        <div class="quick-title">Fee Collection</div>
        <button class="fee-collection-btn">View Details</button>
      </div>
      
      <div class="quick-card">
        <div class="quick-icon">
          <i class="fa-solid fa-chart-line"></i>
        </div>
        <div class="quick-title">Performance Report</div>
      </div>
      
      <div class="quick-card">
        <div class="quick-icon">
          <i class="fa-solid fa-calendar-plus"></i>
        </div>
        <div class="quick-title">Schedule Class</div>
      </div>
    </div>
  </div>
  
  <!-- Fee Collection Modal -->
  <div id="feeCollectionModal" class="modal">
    <div class="modal-content">
        <div class="modal-header">
            <h2>Student Fee Collection Details</h2>
            <span class="close-modal">&times;</span>
        </div>
        <div class="modal-body">
            <div id="paymentDetailsLoading" class="text-center">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
                <p>Loading payment details...</p>
            </div>
            <div class="table-responsive">
                <table id="paymentDetailsTable" class="table table-striped" style="width:100%">
                    <!-- DataTable will populate this -->
                </table>
            </div>
        </div>
    </div>
  </div>
  
  <!-- Include jQuery first -->
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
  <!-- Include DataTables scripts -->
  <script src="https://cdn.datatables.net/1.11.5/js/jquery.dataTables.min.js"></script>
  <script src="https://cdn.datatables.net/buttons/2.2.2/js/dataTables.buttons.min.js"></script>
  <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.html5.min.js"></script>
  <script src="https://cdn.datatables.net/buttons/2.2.2/js/buttons.print.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/pdfmake.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdfmake/0.1.53/vfs_fonts.js"></script>
  
  <!-- Dashboard JavaScript -->
  <script>
  // Simple JavaScript for interactive elements
  document.addEventListener('DOMContentLoaded', function() {
    // Toggle notification visibility
    const notificationIcon = document.querySelector('.fa-bell');
    notificationIcon.addEventListener('click', function() {
      alert('Notifications feature coming soon!');
    });
    
    // Quick access cards
    const quickCards = document.querySelectorAll('.quick-card');
    quickCards.forEach(card => {
      card.addEventListener('click', function(e) {
        // Don't trigger for the Fee Collection card when clicking the View Details button
        if (e.target.classList.contains('fee-collection-btn')) {
          return;
        }
        
        const title = this.querySelector('.quick-title').textContent;
        alert(`${title} feature will be available soon!`);
      });
    });
  });
  </script>
  
  <!-- Fee Collection JavaScript -->
  <script src="../javascripts/feeCollection.js"></script>
</body>
</html>