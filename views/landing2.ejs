                <div class="contact-info">
                    <i>📍</i>
                    <span>123 Dance Street, Bangalore, Karnataka, India</span>
                </div>
                <div class="contact-info">
                    <i>📞</i>
                    <span>+91 9876543210</span>
                </div>
                <div class="contact-info">
                    <i>✉️</i>
